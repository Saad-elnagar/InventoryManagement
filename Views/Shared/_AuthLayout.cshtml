<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Inventory Management</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ui-theme.css"
          asp-append-version="true" />

    <style>
        html,
        body {
            min-height: 100%;
        }

        body.auth-page {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(17, 24, 39, 0.06), transparent 38%),
                #f6f7f9;
            color: #15171a;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 28px 18px;
        }

        .auth-panel {
            width: min(980px, 100%);
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            background: #fff;
            border: 1px solid #e4e6ea;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.10);
        }

        .auth-brand-panel {
            position: relative;
            padding: 48px;
            background: #111;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 620px;
        }

        .auth-brand-panel::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            right: -80px;
            bottom: -80px;
            background: rgba(255, 255, 255, 0.07);
        }

        .auth-brand-mark {
            width: 50px;
            height: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: #fff;
            color: #111;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 28px;
        }

        .auth-brand-title {
            font-size: clamp(34px, 4vw, 48px);
            line-height: 1.02;
            font-weight: 800;
            letter-spacing: -1.5px;
            margin: 0;
        }

        .auth-brand-copy {
            margin-top: 18px;
            max-width: 360px;
            color: rgba(255, 255, 255, 0.72);
            line-height: 1.7;
            font-size: 15px;
        }

        .auth-brand-meta {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255, 255, 255, 0.58);
            font-size: 13px;
        }

        .auth-brand-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #fff;
        }

        .auth-form-panel {
            padding: 48px;
            display: flex;
            align-items: center;
        }

        .auth-container {
            width: 100%;
            max-width: 430px;
            margin: 0 auto;
        }

        .auth-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 11px;
            border-radius: 999px;
            background: #f1f2f4;
            color: #4b5563;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.35px;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .auth-title {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -0.7px;
            margin: 0 0 8px;
            color: #15171a;
        }

        .auth-subtitle {
            color: #6b7280;
            margin-bottom: 28px;
            line-height: 1.6;
        }

        .auth-form .form-label {
            color: #25282d;
            font-size: 14px;
            font-weight: 650;
            margin-bottom: 8px;
        }

        .auth-form .form-control {
            height: 50px;
            border-radius: 12px;
            border: 1px solid #d9dde3;
            background: #fff;
            box-shadow: none;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .auth-form .form-control:focus {
            border-color: #111;
            box-shadow: 0 0 0 4px rgba(17, 17, 17, 0.08);
        }

        .auth-form .btn-primary {
            height: 50px;
            border: 0;
            border-radius: 12px;
            background: #111;
            color: #fff;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(17, 17, 17, 0.14);
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .auth-form .btn-primary:hover {
            background: #000;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(17, 17, 17, 0.18);
        }

        .auth-form .form-check-input {
            border-color: #b9bec7;
        }

        .auth-form .form-check-input:checked {
            background-color: #111;
            border-color: #111;
        }

        .auth-footer {
            text-align: center;
            margin-top: 24px;
            color: #7a8089;
            font-size: 14px;
        }

        .auth-footer a {
            color: #111;
            text-decoration: none;
            font-weight: 700;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors {
            border-radius: 12px;
            font-size: 14px;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
        }

        .text-danger {
            font-size: 13px;
        }

        @media (max-width: 820px) {
            .auth-panel {
                grid-template-columns: 1fr;
                max-width: 520px;
            }

            .auth-brand-panel {
                min-height: auto;
                padding: 32px;
            }

            .auth-brand-copy,
            .auth-brand-meta {
                display: none;
            }

            .auth-form-panel {
                padding: 32px 24px;
            }
        }

        @media (max-width: 480px) {
            .auth-shell {
                padding: 12px;
            }

            .auth-panel {
                border-radius: 18px;
            }

            .auth-brand-panel {
                padding: 26px 24px;
            }

            .auth-brand-title {
                font-size: 34px;
            }

            .auth-form-panel {
                padding: 28px 20px;
            }
        }
    </style>
</head>

<body class="auth-page">

    <div class="auth-shell">

        <div class="auth-panel">

            <section class="auth-brand-panel">

                <div>
                    <div class="auth-brand-mark">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <h2 class="auth-brand-title">
                        Inventory<br />
                        Management
                    </h2>

                    <p class="auth-brand-copy">
                        Keep products, stock movements, purchases and sales
                        organized from one secure workspace.
                    </p>
                </div>

                <div class="auth-brand-meta">
                    <span class="auth-brand-dot"></span>
                    Secure workspace
                </div>

            </section>

            <section class="auth-form-panel">

                <div class="auth-container">
                    @RenderBody()
                </div>

            </section>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>