@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ui-theme.css"
          asp-append-version="true" />
</head>

<body>

@{
    var ctrl =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var fullName =
        User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "User";

    var role =
        User.FindFirst(ClaimTypes.Role)?.Value
        ?? "Employee";

    var canManage =
        User.IsInRole("Admin") ||
        User.IsInRole("Manager");

    var isAdmin =
        User.IsInRole("Admin");

    string Active(params string[] names) =>
        names.Contains(ctrl)
            ? "active"
            : "";

    var initials =
        string.Concat(
                fullName
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2)
                    .Select(x => x[0]))
            .ToUpperInvariant();
}

<header class="app-header">

    <div class="app-header-top">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="app-brand">

            <span class="app-brand-mark">
                <i class="bi bi-boxes"></i>
            </span>

            <span class="app-brand-copy">
                <span class="app-brand-title">
                    Inventory Management
                </span>

                <span class="app-brand-sub">
                    Real-time inventory control center
                </span>
            </span>

        </a>

        <div class="app-user">

            <div class="app-user-card">

                <div class="app-user-avatar">
                    @initials
                </div>

                <div class="app-user-copy">

                    <div class="name">
                        @fullName
                    </div>

                    <div class="role">
                        @role
                    </div>

                </div>

            </div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="m-0">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-light app-logout"
                        title="Sign out"
                        aria-label="Sign out">

                    <i class="bi bi-box-arrow-right"></i>

                </button>

            </form>

        </div>

    </div>

    <div class="app-tabs-wrap">

        <nav class="app-tabs"
             aria-label="Primary navigation">

            <div class="app-nav-group">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="@Active("Dashboard", "Home")">

                    <i class="bi bi-grid-1x2"></i>
                    <span class="nav-text">Dashboard</span>

                </a>

            </div>

            <div class="app-nav-divider"></div>

            <div class="app-nav-group">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="@Active("Product")">

                    <i class="bi bi-box-seam"></i>
                    <span class="nav-text">Products</span>

                </a>

                @if (canManage)
                {
                    <a asp-controller="Category"
                       asp-action="Index"
                       class="@Active("Category")">

                        <i class="bi bi-tags"></i>
                        <span class="nav-text">Categories</span>

                    </a>
                }

                <a asp-controller="StockMovement"
                   asp-action="Index"
                   class="@Active("StockMovement")">

                    <i class="bi bi-arrow-left-right"></i>
                    <span class="nav-text">Movements</span>

                </a>

            </div>

            <div class="app-nav-divider"></div>

            <div class="app-nav-group">

                @if (canManage)
                {
                    <a asp-controller="Purchase"
                       asp-action="Index"
                       class="@Active("Purchase")">

                        <i class="bi bi-cart-plus"></i>
                        <span class="nav-text">Purchases</span>

                    </a>
                }

                <a asp-controller="Sale"
                   asp-action="Index"
                   class="@Active("Sale")">

                    <i class="bi bi-receipt"></i>
                    <span class="nav-text">Sales</span>

                </a>

            </div>

            <div class="app-nav-divider"></div>

            <div class="app-nav-group">

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="@Active("Customer")">

                    <i class="bi bi-person-lines-fill"></i>
                    <span class="nav-text">Customers</span>

                </a>

                @if (canManage)
                {
                    <a asp-controller="Supplier"
                       asp-action="Index"
                       class="@Active("Supplier")">

                        <i class="bi bi-truck"></i>
                        <span class="nav-text">Suppliers</span>

                    </a>
                }

            </div>

            <div class="app-nav-divider"></div>

            <div class="app-nav-group">

                @if (canManage)
                {
                    <a asp-controller="InventoryAi"
                       asp-action="Index"
                       class="@Active("InventoryAi")">

                        <i class="bi bi-stars"></i>
                        <span class="nav-text">AI Assistant</span>
                        <span class="report-nav-badge ai-nav-badge">LOCAL</span>

                    </a>
                }

                @if (isAdmin)
                {
                    <a asp-controller="Report"
                       asp-action="Preview"
                       class="@Active("Report")">

                        <i class="bi bi-bar-chart-line"></i>
                        <span class="nav-text">Reports</span>
                        <span class="report-nav-badge">AI</span>

                    </a>

                    <a asp-controller="User"
                       asp-action="Index"
                       class="@Active("User")">

                        <i class="bi bi-shield-lock"></i>
                        <span class="nav-text">Users</span>

                    </a>
                }

            </div>

        </nav>

    </div>

</header>

<div class="main-wrapper">

    <main role="main">
        @RenderBody()
    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
