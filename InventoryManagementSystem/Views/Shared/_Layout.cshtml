@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Inventory Management
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var fullName =
        User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "User";

    var email =
        User.FindFirst(ClaimTypes.Email)?.Value
        ?? string.Empty;

    var role =
        User.FindFirst(ClaimTypes.Role)?.Value
        ?? "Employee";
}

<div class="app-wrapper">

    <div class="sidebar-overlay"
         id="sidebarOverlay">
    </div>

    <aside class="sidebar"
           id="sidebar">

        <div class="sidebar-brand">

            <svg class="brand-icon"
                 viewBox="0 0 24 24"
                 fill="none">

                <path d="M12 2L2 12L12 22L22 12L12 2Z"
                      fill="white" />

                <path d="M12 6L6 12L12 18L18 12L12 6Z"
                      fill="#172033" />

            </svg>

            <span class="brand-text">
                Inventory
            </span>

        </div>

        <div class="sidebar-section">

            <div class="sidebar-section-title">
                MAIN
            </div>

            <ul class="sidebar-menu">

                <!-- Dashboard -->

                <li>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Home" || currentController == "Dashboard" ? "active" : "")">

                        <i class="bi bi-grid-1x2-fill"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>

                </li>


                <!-- Products -->

                <li>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Product" ? "active" : "")">

                        <i class="bi bi-box-seam"></i>

                        <span>
                            Products
                        </span>

                    </a>

                </li>


                <!-- Categories -->

                @if (User.IsInRole("Admin") ||
                     User.IsInRole("Manager"))
                {
                    <li>

                        <a asp-controller="Category"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Category" ? "active" : "")">

                            <i class="bi bi-tags"></i>

                            <span>
                                Categories
                            </span>

                        </a>

                    </li>
                }


                <!-- Suppliers -->

                @if (User.IsInRole("Admin") ||
                     User.IsInRole("Manager"))
                {
                    <li>

                        <a asp-controller="Supplier"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Supplier" ? "active" : "")">

                            <i class="bi bi-truck"></i>

                            <span>
                                Suppliers
                            </span>

                        </a>

                    </li>
                }


                <!-- Customers -->

                <li>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Customer" ? "active" : "")">

                        <i class="bi bi-people"></i>

                        <span>
                            Customers
                        </span>

                    </a>

                </li>


                <!-- Purchases -->

                @if (User.IsInRole("Admin") ||
                     User.IsInRole("Manager"))
                {
                    <li>

                        <a asp-controller="Purchase"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Purchase" ? "active" : "")">

                            <i class="bi bi-cart-plus"></i>

                            <span>
                                Purchases
                            </span>

                        </a>

                    </li>
                }


                <!-- Sales -->

                <li>

                    <a asp-controller="Sale"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Sale" ? "active" : "")">

                        <i class="bi bi-receipt"></i>

                        <span>
                            Sales
                        </span>

                    </a>

                </li>

            </ul>

        </div>


        <!-- INVENTORY -->

        <div class="sidebar-section">

            <div class="sidebar-section-title">
                INVENTORY
            </div>

            <ul class="sidebar-menu">

                <li>

                    <a asp-controller="StockMovement"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "StockMovement" ? "active" : "")">

                        <i class="bi bi-arrow-left-right"></i>

                        <span>
                            Stock Movements
                        </span>

                    </a>

                </li>

            </ul>

        </div>



        <!-- REPORTS -->

        @if (User.IsInRole("Admin"))
        {
            <div class="sidebar-section">

                <div class="sidebar-section-title">
                    REPORTS
                </div>

                <ul class="sidebar-menu">

                    <li>

                        <a asp-controller="Report"
                           asp-action="Preview"
                           class="sidebar-link @(currentController == "Report" ? "active" : "")">

                            <i class="bi bi-bar-chart-line"></i>

                            <span>
                                Daily Report
                            </span>

                            <span class="sidebar-ai-badge">
                                AI
                            </span>

                        </a>

                    </li>

                </ul>

            </div>
        }

        <!-- ADMINISTRATION -->

        @if (User.IsInRole("Admin"))
        {
            <div class="sidebar-section">

                <div class="sidebar-section-title">
                    ADMINISTRATION
                </div>

                <ul class="sidebar-menu">

                    <li>

                        <a asp-controller="User"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "User" ? "active" : "")">

                            <i class="bi bi-people"></i>

                            <span>
                                Users
                            </span>

                        </a>

                    </li>

                </ul>

            </div>
        }


        <!-- USER -->

        <div class="sidebar-user">

            <div class="sidebar-avatar">

                <i class="bi bi-person"></i>

            </div>

            <div class="sidebar-user-info">

                <span class="sidebar-user-name">
                    @fullName
                </span>

                <span class="sidebar-user-email">
                    @email
                </span>

                <span class="badge
                    @(role == "Admin"
                        ? "bg-danger"
                        : role == "Manager"
                            ? "bg-warning text-dark"
                            : "bg-secondary")">

                    @role

                </span>

            </div>

            <div class="ms-auto">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-sm btn-link text-danger p-0"
                            title="Logout">

                        <i class="bi bi-box-arrow-right fs-5"></i>

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <div class="main-wrapper">

        <div class="mobile-topbar">

            <button type="button"
                    class="btn btn-light action-btn"
                    id="sidebarToggle">

                <i class="bi bi-list fs-5"></i>

            </button>

            <div class="fw-bold text-dark">
                Inventory Management
            </div>

            <i class="bi bi-box-seam text-primary fs-5"></i>

        </div>

        <main role="main">

            @RenderBody()

        </main>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

<script>

    const sidebar =
        document.getElementById("sidebar");

    const sidebarToggle =
        document.getElementById("sidebarToggle");

    const sidebarOverlay =
        document.getElementById("sidebarOverlay");


    function closeSidebar() {

        sidebar.classList.remove("show");

        sidebarOverlay.classList.remove("show");

    }


    if (sidebarToggle) {

        sidebarToggle.addEventListener(
            "click",
            function () {

                sidebar.classList.toggle("show");

                sidebarOverlay.classList.toggle("show");

            });

    }


    if (sidebarOverlay) {

        sidebarOverlay.addEventListener(
            "click",
            closeSidebar);

    }

</script>


@await RenderSectionAsync(
    "Scripts",
    required: false)

</body>

</html>