@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-theme.css" asp-append-version="true" />
</head>
<body>
    @{
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
        var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
        var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "Employee";
        var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
        string Active(params string[] names) => names.Contains(ctrl) ? "active" : "";
    }

    <header class="app-header">
        <div class="app-header-top">
            <div>
                <h1 class="app-brand-title">Inventory Management Tool</h1>
                <p class="app-brand-sub">Real-time inventory tracking and management</p>
            </div>

            <div class="app-user">
                <div class="text-end">
                    <div class="name">@fullName</div>
                    <div class="role">@role</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-light border" title="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>

        <div class="app-tabs-wrap">
            <nav class="app-tabs">
                <a asp-controller="Home" asp-action="Index" class="@Active("Home", "Dashboard")">Dashboard</a>
                <a asp-controller="Product" asp-action="Index" class="@Active("Product")">Products</a>
                @if (canManage)
                {
                    <a asp-controller="Purchase" asp-action="Index" class="@Active("Purchase")">Purchases</a>
                    <a asp-controller="Category" asp-action="Index" class="@Active("Category")">Categories</a>
                }
                <a asp-controller="Sale" asp-action="Index" class="@Active("Sale")">Sales</a>
                <a asp-controller="StockMovement" asp-action="Index" class="@Active("StockMovement")">Stock Movements</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="User" asp-action="Index" class="@Active("User")">Users</a>
                }
            </nav>
        </div>
    </header>

    <div class="main-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
