@model IEnumerable<InventoryManagementSystem.BLL.DTOs.SupplierDTO>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1b2559;">Suppliers</h3>
            <p class="text-muted small mb-0">@Model.Count() suppliers</p>
        </div>

        <a asp-action="Create" class="btn btn-primary rounded-3">
            <i class="bi bi-plus-lg me-1"></i>
            Add Supplier
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Supplier</th>
                        <th>Contact</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td class="fw-semibold">@s.SupplierName</td>
                            <td>@s.ContactName</td>
                            <td>@s.Phone</td>
                            <td>@s.Email</td>
                            <td>@s.Address</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-light border">Details</a>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-light border">Edit</a>
                                <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>