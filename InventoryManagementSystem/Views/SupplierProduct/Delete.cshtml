@model InventoryManagementSystem.BLL.DTOs.SupplierDTO

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0" style="color: #1b2559;">Delete Supplier</h3>

        <a asp-action="Index" class="btn btn-light border rounded-3">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="alert alert-danger">
                Are you sure you want to delete this supplier? This action cannot be undone.
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">Supplier</dt>
                <dd class="col-sm-9">@Model.SupplierName</dd>

                <dt class="col-sm-3">Contact</dt>
                <dd class="col-sm-9">@Model.ContactName</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Model.Address</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger rounded-3">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-light border rounded-3">Cancel</a>
            </form>

        </div>
    </div>

</div>