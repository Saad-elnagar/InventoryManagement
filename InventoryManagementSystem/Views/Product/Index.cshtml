@model InventoryManagementSystem.BLL.Pagination.PaginationResult<InventoryManagementSystem.BLL.DTOs.ProductDTO>

@{
    ViewData["Title"] = "Products";

    var totalProducts = Model.TotalCount;
    var lowStock = Model.Data.Count(x => x.Quantity > 0 && x.Quantity <= x.ReorderLevel);
    var outOfStock = Model.Data.Count(x => x.Quantity == 0);
    var inStock = Model.Data.Count(x => x.Quantity > x.ReorderLevel);
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1" style="color: #1b2559;">
                Products
            </h3>

            <p class="text-muted small mb-0">
                Manage and monitor your inventory products
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">

            <a asp-action="LowStock"
               class="btn btn-light shadow-sm rounded-3">
                <i class="bi bi-exclamation-triangle text-warning"></i>
                Low Stock
            </a>

            <a asp-action="Create"
               class="btn text-white rounded-3 px-3"
               style="background-color: #0d47a1;">
                <i class="bi bi-plus-lg me-1"></i>
                Add Product
            </a>

        </div>

    </div>


    <!-- Statistics -->

    <div class="row g-3 mb-4">

        <!-- Total -->

        <div class="col-12 col-md-6 col-xl-3">

            <div class="card border-0 rounded-4 p-3 shadow-sm text-white h-100"
                 style="background-color: #0d47a1;">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <span class="small"
                          style="color: rgba(255,255,255,.7);">
                        Total Products
                    </span>

                    <div class="d-flex align-items-center justify-content-center rounded-3"
                         style="background-color: rgba(255,255,255,.15);
                                width: 38px;
                                height: 38px;">

                        <i class="bi bi-box-seam fs-5"></i>

                    </div>

                </div>

                <h3 class="fw-bold mb-0">
                    @totalProducts
                </h3>

            </div>

        </div>


        <!-- In Stock -->

        <div class="col-12 col-md-6 col-xl-3">

            <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <span class="text-muted small">
                        In Stock
                    </span>

                    <div class="d-flex align-items-center justify-content-center rounded-3"
                         style="background-color: #e8f5e9;
                                width: 38px;
                                height: 38px;">

                        <i class="bi bi-check-circle text-success fs-5"></i>

                    </div>

                </div>

                <h3 class="fw-bold mb-0" style="color: #1b2559;">
                    @inStock
                </h3>

            </div>

        </div>


        <!-- Low Stock -->

        <div class="col-12 col-md-6 col-xl-3">

            <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <span class="text-muted small">
                        Low Stock
                    </span>

                    <div class="d-flex align-items-center justify-content-center rounded-3"
                         style="background-color: #fff8e1;
                                width: 38px;
                                height: 38px;">

                        <i class="bi bi-exclamation-triangle text-warning fs-5"></i>

                    </div>

                </div>

                <h3 class="fw-bold mb-0 text-warning">
                    @lowStock
                </h3>

            </div>

        </div>


        <!-- Out Of Stock -->

        <div class="col-12 col-md-6 col-xl-3">

            <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <span class="text-muted small">
                        Out of Stock
                    </span>

                    <div class="d-flex align-items-center justify-content-center rounded-3"
                         style="background-color: #ffebee;
                                width: 38px;
                                height: 38px;">

                        <i class="bi bi-x-circle text-danger fs-5"></i>

                    </div>

                </div>

                <h3 class="fw-bold mb-0 text-danger">
                    @outOfStock
                </h3>

            </div>

        </div>

    </div>


    <!-- Products Table -->

    <div class="card border-0 rounded-4 shadow-sm bg-white">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1"
                        style="color: #1b2559;">
                        Product List
                    </h5>

                    <small class="text-muted">
                        Showing page @Model.Page of @Model.TotalPages
                    </small>

                </div>

                <span class="badge rounded-pill px-3 py-2"
                      style="background-color: #e3f2fd;
                             color: #0d47a1;">
                    @Model.TotalCount Products
                </span>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-borderless align-middle mb-0">

                <thead>

                    <tr class="border-bottom text-muted small">

                        <th class="ps-4">
                            Product
                        </th>

                        <th>
                            Description
                        </th>

                        <th>
                            Price
                        </th>

                        <th>
                            Quantity
                        </th>

                        <th>
                            Reorder Level
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end pe-4">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                @if (!Model.Data.Any())
                {
                    <tr>

                        <td colspan="7"
                            class="text-center py-5">

                            <i class="bi bi-box-seam fs-1 text-muted"></i>

                            <h6 class="mt-3 fw-bold">
                                No Products Found
                            </h6>

                            <p class="text-muted small">
                                There are no products to display.
                            </p>

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var product in Model.Data)
                    {
                        <tr class="border-bottom">

                            <td class="ps-4">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                                         style="width: 42px;
                                                height: 42px;
                                                background-color: #e3f2fd;">

                                        <i class="bi bi-box-seam text-primary"></i>

                                    </div>

                                    <div>

                                        <div class="fw-semibold"
                                             style="color: #1b2559;">
                                            @product.Name
                                        </div>

                                        <small class="text-muted">
                                            #@product.Id
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <span class="text-muted small">

                                    @(string.IsNullOrWhiteSpace(product.Description)
                                        ? "No description"
                                        : product.Description)

                                </span>

                            </td>


                            <td>

                                <span class="fw-semibold"
                                      style="color: #1b2559;">

                                    EGP @product.Price.ToString("N2")

                                </span>

                            </td>


                            <td>

                                <span class="fw-semibold">
                                    @product.Quantity
                                </span>

                            </td>


                            <td>

                                <span class="text-muted">
                                    @product.ReorderLevel
                                </span>

                            </td>


                            <td>

                                @if (product.Quantity == 0)
                                {
                                    <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2">
                                        Out of Stock
                                    </span>
                                }
                                else if (product.Quantity <= product.ReorderLevel)
                                {
                                    <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning px-3 py-2">
                                        Low
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                        Available
                                    </span>
                                }

                            </td>


                            <td class="text-end pe-4">

                                <div class="d-flex justify-content-end gap-1">

                                    <a asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-sm btn-light rounded-3"
                                       title="Details">

                                        <i class="bi bi-eye text-primary"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn btn-sm btn-light rounded-3"
                                       title="Edit">

                                        <i class="bi bi-pencil text-primary"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@product.Id"
                                       class="btn btn-sm btn-light rounded-3"
                                       title="Delete">

                                        <i class="bi bi-trash text-danger"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }

                </tbody>

            </table>

        </div>


        <!-- Pagination -->

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <small class="text-muted">
                        Page @Model.Page of @Model.TotalPages
                    </small>

                    <nav>

                        <ul class="pagination pagination-sm mb-0">

                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.Page - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-left"></i>
                                </a>

                            </li>


                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@Model.PageSize">

                                        @i

                                    </a>

                                </li>
                            }


                            <li class="page-item @(Model.HasNext ? "" : "disabled")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.Page + 1)"
                                   asp-route-pageSize="@Model.PageSize">

                                    <i class="bi bi-chevron-right"></i>

                                </a>

                            </li>

                        </ul>

                    </nav>

                </div>

            </div>
        }

    </div>

</div>