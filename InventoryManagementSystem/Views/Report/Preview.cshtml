@model InventoryManagementSystem.Models.Reports.DailyReportPreviewViewModel

@{
    ViewData["Title"] = "Daily Report";
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1"
                style="color:#1b2559;">
                Daily Inventory Report
            </h3>

            <p class="text-muted mb-0">
                @Model.Report.From.ToString("yyyy-MM-dd HH:mm")
                -
                @Model.Report.To.ToString("yyyy-MM-dd HH:mm")
            </p>
        </div>

        <form asp-action="SendNow"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-envelope me-2"></i>

                Send Report Now

            </button>

        </form>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-4">

        <div class="col-12 col-xl-8">

            <div class="card p-4 mb-4">

                <div class="d-flex justify-content-between mb-3">

                    <h5 class="fw-bold mb-0">
                        AI Summary
                    </h5>

                    <span class="badge bg-primary">
                        AI
                    </span>

                </div>

                <div class="bg-light rounded-3 p-4"
                     style="white-space:pre-line;">

                    @Model.Summary

                </div>

            </div>

            <div class="card p-4">

                <h5 class="fw-bold mb-3">
                    Movements By Type
                </h5>

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                        <tr>
                            <th>Type</th>
                            <th>Count</th>
                            <th>Quantity</th>
                        </tr>

                        </thead>

                        <tbody>

                        @foreach (
                            var movement
                            in Model.Report.MovementsByType)
                        {
                            <tr>

                                <td>
                                    @movement.MovementType
                                </td>

                                <td>
                                    @movement.Count
                                </td>

                                <td>
                                    @movement.TotalQuantity
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-12 col-xl-4">

            <div class="card p-4 mb-4">

                <h6 class="text-muted">
                    Total Products
                </h6>

                <h2 class="fw-bold">
                    @Model.Report.TotalProducts
                </h2>

            </div>

            <div class="card p-4 mb-4">

                <h6 class="text-muted">
                    Stock Movements
                </h6>

                <h2 class="fw-bold">
                    @Model.Report.MovementsCount
                </h2>

            </div>

            <div class="card p-4">

                <h5 class="fw-bold mb-3">
                    Low Stock
                </h5>

                @if (Model.Report.LowStockProducts.Any())
                {
                    @foreach (
                        var product
                        in Model.Report.LowStockProducts)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">

                            <div>
                                <strong>
                                    @product.Name
                                </strong>

                                <small class="d-block text-muted">
                                    Reorder:
                                    @product.ReorderLevel
                                </small>
                            </div>

                            <span class="badge bg-warning text-dark">
                                @product.Quantity
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">
                        No low stock products.
                    </div>
                }

            </div>

        </div>

    </div>

</div>