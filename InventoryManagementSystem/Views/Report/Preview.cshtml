@model InventoryManagementSystem.Models.Reports.DailyReportPreviewViewModel

@{
    ViewData["Title"] = "Daily Report";

    var lowStockCount = Model.Report.LowStockProducts.Count;
}

<div class="page-container report-page">

    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="report-title-icon">
                    <i class="bi bi-stars"></i>
                </span>
                <span class="status-badge status-primary">AI-powered</span>
            </div>

            <h1 class="page-title mb-1">
                Daily Inventory Report
            </h1>

            <p class="page-subtitle mb-0">
                Smart inventory insights from your latest stock activity.
            </p>
        </div>

        <form asp-action="SendNow" method="post" class="m-0">
            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send me-2"></i>
                Send Report
            </button>
        </form>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="stat-card report-stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Total Products</div>
                        <h2 class="stat-value">@Model.Report.TotalProducts</h2>
                        <div class="report-stat-note">Products tracked in inventory</div>
                    </div>
                    <div class="stat-icon report-icon-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="stat-card report-stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Stock Movements</div>
                        <h2 class="stat-value">@Model.Report.MovementsCount</h2>
                        <div class="report-stat-note">Last 24 hours</div>
                    </div>
                    <div class="stat-icon report-icon-success">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="stat-card report-stat-card @(lowStockCount > 0 ? "report-stat-danger" : "")">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Low Stock Alerts</div>
                        <h2 class="stat-value">@lowStockCount</h2>
                        <div class="report-stat-note">
                            @(lowStockCount > 0 ? "Products need attention" : "No urgent alerts")
                        </div>
                    </div>
                    <div class="stat-icon @(lowStockCount > 0 ? "report-icon-danger" : "report-icon-warning")">
                        <i class="bi @(lowStockCount > 0 ? "bi-exclamation-triangle" : "bi-check2-circle")"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-8">

            <div class="card report-card report-ai-card mb-4">

                <div class="report-card-header">

                    <div class="d-flex align-items-center gap-3">

                        <div class="report-ai-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>
                            <h5 class="mb-1 fw-bold">Smart Inventory Insights</h5>
                            <p class="text-muted mb-0 small">
                                ML.NET demand forecasting and stock risk analysis
                            </p>
                        </div>

                    </div>

                    <span class="status-badge status-primary">
                        ML.NET
                    </span>

                </div>

                <div class="report-ai-body">

                    <div class="report-period">
                        <i class="bi bi-clock me-2"></i>
                        @Model.Report.From.ToString("yyyy-MM-dd HH:mm")
                        <span class="mx-2">→</span>
                        @Model.Report.To.ToString("yyyy-MM-dd HH:mm")
                    </div>

                    <div class="report-summary">
                        <div class="report-summary-label">AI Analysis</div>

                        <div class="report-summary-text"
                             id="aiReportSummary">
                            <div class="d-flex align-items-center gap-2 text-muted">
                                <span class="spinner-border spinner-border-sm"
                                      role="status"
                                      aria-hidden="true"></span>
                                <span>Generating AI analysis...</span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <div class="card report-card">

                <div class="report-card-header">
                    <div>
                        <h5 class="mb-1 fw-bold">Stock Movements</h5>
                        <p class="text-muted mb-0 small">
                            Activity grouped by movement type
                        </p>
                    </div>
                </div>

                @if (Model.Report.MovementsByType.Any())
                {
                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>
                                <tr>
                                    <th>Movement</th>
                                    <th>Transactions</th>
                                    <th>Units</th>
                                </tr>
                            </thead>

                            <tbody>

                            @foreach (var movement in Model.Report.MovementsByType)
                            {
                                <tr>
                                    <td>
                                        <span class="movement-pill">
                                            <i class="bi bi-arrow-repeat"></i>
                                            @movement.MovementType
                                        </span>
                                    </td>
                                    <td><strong>@movement.Count</strong></td>
                                    <td>@Math.Abs(movement.TotalQuantity)</td>
                                </tr>
                            }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="report-empty">
                        <i class="bi bi-inbox"></i>
                        <strong>No stock movements</strong>
                        <span>No movement activity was recorded in the report period.</span>
                    </div>
                }

            </div>

        </div>

        <div class="col-12 col-xl-4">

            <div class="card report-card">

                <div class="report-card-header">

                    <div>
                        <h5 class="mb-1 fw-bold">Low Stock</h5>
                        <p class="text-muted mb-0 small">
                            Products at or below reorder level
                        </p>
                    </div>

                    @if (lowStockCount > 0)
                    {
                        <span class="status-badge status-danger">
                            @lowStockCount alert@(lowStockCount == 1 ? "" : "s")
                        </span>
                    }

                </div>

                @if (Model.Report.LowStockProducts.Any())
                {
                    <div class="report-low-stock-list">

                        @foreach (var product in Model.Report.LowStockProducts)
                        {
                            <div class="report-low-stock-item">

                                <div class="report-product-icon">
                                    <i class="bi bi-box"></i>
                                </div>

                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate">@product.Name</div>

                                    <div class="small text-muted">
                                        Reorder level: @product.ReorderLevel
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="report-stock-number">@product.Quantity</div>
                                    <div class="small text-danger">current</div>
                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="report-empty">
                        <i class="bi bi-check2-circle text-success"></i>
                        <strong>All good</strong>
                        <span>No products need restocking right now.</span>
                    </div>
                }

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const summaryElement =
                document.getElementById("aiReportSummary");

            if (!summaryElement) {
                return;
            }

            try {
                const response =
                    await fetch(
                        '@Url.Action("AiSummary", "Report")',
                        {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            },
                            cache: "no-store"
                        });

                if (!response.ok) {
                    throw new Error("AI summary request failed.");
                }

                const result = await response.json();

                if (result.success && result.summary) {
                    summaryElement.textContent = result.summary;
                    return;
                }

                throw new Error(
                    result.message || "AI summary unavailable.");
            }
            catch (error) {
                summaryElement.innerHTML = `
                    <div class="text-muted">
                        <i class="bi bi-info-circle me-2"></i>
                        AI analysis is temporarily unavailable.
                        The report data above is still valid.
                    </div>`;
            }
        });
    </script>
}
