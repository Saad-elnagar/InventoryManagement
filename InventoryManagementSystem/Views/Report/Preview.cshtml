@model InventoryManagementSystem.Models.Reports.DailyReportPreviewViewModel

@{
    ViewData["Title"] = "Daily Report";

    var lowStockCount = Model.Report.LowStockProducts.Count;
    var movementCount = Model.Report.MovementsCount;
}

<div class="page-container report-page">

    <div class="page-header report-header">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="report-title-icon">
                    <i class="bi bi-stars"></i>
                </span>

                <span class="status-badge status-primary">
                    AI-powered
                </span>

            </div>

            <h1 class="page-title">
                Daily Inventory Report
            </h1>

            <p class="page-subtitle">
                Smart inventory insights based on your latest stock activity and sales history.
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Report"
               asp-action="Daily"
               class="btn btn-light">
                <i class="bi bi-code-slash me-2"></i>
                View Data
            </a>

            <form asp-action="SendNow"
                  method="post"
                  class="m-0">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-send me-2"></i>
                    Send Report

                </button>

            </form>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success report-alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger report-alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="stat-card report-stat-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="stat-label">
                            Total Products
                        </div>

                        <h2 class="stat-value">
                            @Model.Report.TotalProducts
                        </h2>

                        <div class="report-stat-note">
                            Products tracked in inventory
                        </div>
                    </div>

                    <div class="stat-icon report-icon-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="stat-card report-stat-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="stat-label">
                            Stock Movements
                        </div>

                        <h2 class="stat-value">
                            @movementCount
                        </h2>

                        <div class="report-stat-note">
                            Activity in the last 24 hours
                        </div>
                    </div>

                    <div class="stat-icon report-icon-success">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="stat-card report-stat-card @(lowStockCount > 0 ? "report-stat-danger" : "")">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="stat-label">
                            Low Stock Alerts
                        </div>

                        <h2 class="stat-value">
                            @lowStockCount
                        </h2>

                        <div class="report-stat-note">
                            @(lowStockCount > 0
                                ? "Products need attention"
                                : "Everything is above reorder level")
                        </div>
                    </div>

                    <div class="stat-icon @(lowStockCount > 0 ? "report-icon-danger" : "report-icon-warning")">
                        <i class="bi @(lowStockCount > 0 ? "bi-exclamation-triangle" : "bi-check2-circle")"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-8">

            <div class="card report-card report-ai-card mb-4">

                <div class="report-card-header">

                    <div class="d-flex align-items-center gap-3">

                        <div class="report-ai-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>

                            <h5 class="mb-1 fw-bold">
                                Smart Inventory Insights
                            </h5>

                            <p class="text-muted mb-0 small">
                                ML.NET demand forecasting and stock risk analysis
                            </p>

                        </div>

                    </div>

                    <span class="status-badge status-primary">
                        ML.NET
                    </span>

                </div>

                <div class="report-ai-body">

                    <div class="report-period">
                        <i class="bi bi-calendar3 me-2"></i>
                        @Model.Report.From.ToString("yyyy-MM-dd HH:mm")
                        <span class="mx-2">→</span>
                        @Model.Report.To.ToString("yyyy-MM-dd HH:mm")
                    </div>

                    <div class="report-summary">

                        <div class="report-summary-label">
                            AI Analysis
                        </div>

                        <div class="report-summary-text">
                            @Model.Summary
                        </div>

                    </div>

                </div>

            </div>

            <div class="card report-card">

                <div class="report-card-header">

                    <div>
                        <h5 class="mb-1 fw-bold">
                            Stock Movements
                        </h5>

                        <p class="text-muted mb-0 small">
                            Movement activity grouped by type
                        </p>
                    </div>

                </div>

                @if (Model.Report.MovementsByType.Any())
                {
                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>

                            <tr>
                                <th>Movement</th>
                                <th>Transactions</th>
                                <th>Units</th>
                            </tr>

                            </thead>

                            <tbody>

                            @foreach (var movement in Model.Report.MovementsByType)
                            {
                                <tr>

                                    <td>

                                        <span class="movement-pill">
                                            <i class="bi bi-arrow-repeat"></i>
                                            @movement.MovementType
                                        </span>

                                    </td>

                                    <td>
                                        <strong>
                                            @movement.Count
                                        </strong>
                                    </td>

                                    <td>
                                        @Math.Abs(movement.TotalQuantity)
                                    </td>

                                </tr>
                            }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="report-empty">
                        <i class="bi bi-inbox"></i>
                        <strong>No stock movements</strong>
                        <span>No movement activity was recorded in the report period.</span>
                    </div>
                }

            </div>

        </div>

        <div class="col-12 col-xl-4">

            <div class="card report-card">

                <div class="report-card-header">

                    <div>
                        <h5 class="mb-1 fw-bold">
                            Low Stock
                        </h5>

                        <p class="text-muted mb-0 small">
                            Products at or below reorder level
                        </p>
                    </div>

                    @if (lowStockCount > 0)
                    {
                        <span class="status-badge status-danger">
                            @lowStockCount alert@(lowStockCount == 1 ? "" : "s")
                        </span>
                    }

                </div>

                @if (Model.Report.LowStockProducts.Any())
                {
                    <div class="report-low-stock-list">

                        @foreach (var product in Model.Report.LowStockProducts)
                        {
                            <div class="report-low-stock-item">

                                <div class="report-product-icon">
                                    <i class="bi bi-box"></i>
                                </div>

                                <div class="flex-grow-1 min-w-0">

                                    <div class="fw-semibold text-truncate">
                                        @product.Name
                                    </div>

                                    <div class="small text-muted">
                                        Reorder level: @product.ReorderLevel
                                    </div>

                                </div>

                                <div class="text-end">

                                    <div class="report-stock-number">
                                        @product.Quantity
                                    </div>

                                    <div class="small text-danger">
                                        current
                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="report-empty">
                        <i class="bi bi-check2-circle text-success"></i>
                        <strong>All good</strong>
                        <span>No products need restocking right now.</span>
                    </div>
                }

            </div>

        </div>

    </div>

</div>
