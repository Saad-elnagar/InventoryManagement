@model IEnumerable<InventoryManagementSystem.BLL.DTOs.CustomerDTO>

@{
    ViewData["Title"] = "Customers";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Customers</h2>
            <p class="text-muted mb-0">
                Manage your customers and their contact information.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary rounded-3 px-4">

            <i class="bi bi-person-plus me-1"></i>
            Add Customer

        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Total Customers
                </small>

                <h3 class="fw-bold mt-2 mb-0">
                    @Model.Count()
                </h3>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Customers With Phone
                </small>

                <h3 class="fw-bold mt-2 mb-0 text-success">
                    @Model.Count(x => !string.IsNullOrWhiteSpace(x.Phone))
                </h3>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Customers With Email
                </small>

                <h3 class="fw-bold mt-2 mb-0 text-primary">
                    @Model.Count(x => !string.IsNullOrWhiteSpace(x.Email))
                </h3>

            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="input-group">

                <span class="input-group-text border-0 bg-transparent">
                    <i class="bi bi-search text-muted"></i>
                </span>

                <input type="text"
                       id="customerSearch"
                       class="form-control border-0 shadow-none"
                       placeholder="Search customers..." />

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                <tr>

                    <th class="ps-4">Customer</th>
                    <th>Contact</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th class="text-end pe-4">Actions</th>

                </tr>

                </thead>

                <tbody>

                @foreach (var item in Model)
                {
                    <tr class="customer-row">

                        <td class="ps-4">

                            <div class="d-flex align-items-center gap-3">

                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                                    <i class="bi bi-person-fill fs-5"></i>
                                </div>

                                <div>

                                    <h6 class="fw-bold mb-0">
                                        @item.Name
                                    </h6>

                                    <span class="text-muted small">
                                        #@item.Id
                                    </span>

                                </div>

                            </div>

                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.Name)
                                ? "N/A"
                                : item.Name)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.Phone)
                                ? "N/A"
                                : item.Phone)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.Email)
                                ? "N/A"
                                : item.Email)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.Address)
                                ? "N/A"
                                : item.Address)
                        </td>

                        <td class="text-end pe-4">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-light text-primary">

                                <i class="bi bi-eye"></i>

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-light text-warning">

                                <i class="bi bi-pencil"></i>

                            </a>

                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("Manager"))
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light text-danger">

                                    <i class="bi bi-trash"></i>

                                </a>
                            }

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const searchInput =
            document.getElementById("customerSearch");

        const rows =
            document.querySelectorAll(".customer-row");

        searchInput.addEventListener("input", function () {

            const search =
                this.value.trim().toLowerCase();

            rows.forEach(row => {

                row.style.display =
                    row.textContent
                        .toLowerCase()
                        .includes(search)
                        ? ""
                        : "none";

            });

        });

    </script>
}