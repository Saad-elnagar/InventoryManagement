@using InventoryManagementSystem.BLL.DTOs
@using InventoryManagementSystem.BLL.Enums

@model CreateStockMovementDTO

@{
    ViewData["Title"] = "Add Stock Movement";

    var products =
        ViewBag.Products as IEnumerable<ProductDTO>
        ?? Enumerable.Empty<ProductDTO>();

    var movementTypes =
        ViewBag.MovementTypes as StockMovementType[]
        ?? Array.Empty<StockMovementType>();
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="mb-4">

                <a asp-action="Index"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Stock Movements

                </a>

                <h2 class="fw-bold mt-3 mb-1">
                    Add Stock Movement
                </h2>

                <p class="text-muted mb-0">
                    Record a manual inventory adjustment.
                </p>

            </div>


            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="mb-4">

                            <label asp-for="ProductId"
                                   class="form-label fw-semibold">

                                Product

                            </label>

                            <select asp-for="ProductId"
                                    class="form-select">

                                <option value="">
                                    Select Product
                                </option>

                                @foreach (var product in products)
                                {
                                    <option value="@product.Id">

                                        @product.Name
                                        -
                                        Stock: @product.Quantity

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ProductId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="MovementType"
                                   class="form-label fw-semibold">

                                Movement Type

                            </label>

                            <select asp-for="MovementType"
                                    class="form-select"
                                    id="movementType">

                                <option value="">
                                    Select Movement Type
                                </option>

                                @foreach (var type in movementTypes)
                                {
                                    <option value="@type">

                                        @type

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="MovementType"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Quantity"
                                   class="form-label fw-semibold">

                                Quantity

                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter quantity" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Enter a positive number.
                                The system decides whether stock increases
                                or decreases based on the movement type.
                            </small>

                        </div>


                        <div class="mb-4 d-none"
                             id="directionContainer">

                            <label asp-for="Direction"
                                   class="form-label fw-semibold">

                                Adjustment Direction

                            </label>

                            <select asp-for="Direction"
                                    class="form-select">

                                <option value="@StockMovementDirection.Increase">
                                    Increase Stock
                                </option>

                                <option value="@StockMovementDirection.Decrease">
                                    Decrease Stock
                                </option>

                            </select>

                            <small class="text-muted">
                                Used only for Adjustment.
                            </small>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Reason"
                                   class="form-label fw-semibold">

                                Reason

                            </label>

                            <input asp-for="Reason"
                                   class="form-control"
                                   placeholder="e.g. Damaged product" />

                            <span asp-validation-for="Reason"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Notes"
                                   class="form-label fw-semibold">

                                Notes

                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Additional notes..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="alert alert-info border-0 rounded-3">

                            <i class="bi bi-info-circle me-1"></i>

                            <strong>Important:</strong>

                            Sales and Purchases are created
                            automatically by their own modules.

                        </div>


                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="btn btn-light border rounded-3">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4 rounded-3">

                                <i class="bi bi-plus-circle me-1"></i>

                                Save Movement

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const movementType =
            document.getElementById("movementType");

        const directionContainer =
            document.getElementById(
                "directionContainer");

        function updateDirectionVisibility() {

            if (movementType.value === "Adjustment") {

                directionContainer.classList.remove("d-none");

            }
            else {

                directionContainer.classList.add("d-none");

            }

        }

        movementType.addEventListener(
            "change",
            updateDirectionVisibility);

        updateDirectionVisibility();

    </script>
}