@model InventoryManagementSystem.BLL.DTOs.StockMovementDTO
@using InventoryManagementSystem.BLL.Enums

@{
    ViewData["Title"] = "Movement Details";

    var inTypes = new[]
    {
        StockMovementType.Purchase,
        StockMovementType.Found,
        StockMovementType.OpeningStock,
        StockMovementType.VendorGift,
        StockMovementType.SaleReturn
    };

    var isIn = inTypes.Contains(Model.MovementType);
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1" style="color: #1b2559;">
                Movement Details
            </h3>

            <p class="text-muted small mb-0">
                #@Model.Id &middot; @Model.ProductName
            </p>
        </div>

        <a asp-action="Index" class="btn btn-light border rounded-3">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>

    </div>


    <div class="card border-0 rounded-4 shadow-sm bg-white">

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-12 col-md-6">
                    <div class="text-muted small mb-1">Product</div>
                    <div class="fw-semibold" style="color:#1b2559;">@Model.ProductName</div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-muted small mb-1">Type</div>
                    <span class="badge rounded-pill px-3 py-2 @(isIn ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger")">
                        @Model.MovementType
                    </span>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-muted small mb-1">Quantity</div>
                    <div class="fw-semibold @(isIn ? "text-success" : "text-danger")">
                        @(isIn ? "+" : "-")@Model.Quantity
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-muted small mb-1">Date</div>
                    <div class="fw-semibold" style="color:#1b2559;">
                        @Model.MovementDate.ToString("dd MMM yyyy HH:mm")
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-muted small mb-1">Reference</div>
                    <div class="fw-semibold" style="color:#1b2559;">
                        @(string.IsNullOrWhiteSpace(Model.ReferenceType) ? "N/A" : $"{Model.ReferenceType} #{Model.ReferenceId}")
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-muted small mb-1">Reason</div>
                    <div class="fw-semibold" style="color:#1b2559;">
                        @(string.IsNullOrWhiteSpace(Model.Reason) ? "-" : Model.Reason)
                    </div>
                </div>

                <div class="col-12">
                    <div class="text-muted small mb-1">Notes</div>
                    <div class="text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes." : Model.Notes)
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>
