@model List<InventoryManagementSystem.BLL.DTOs.StockMovementDTO>
@using InventoryManagementSystem.BLL.Enums

@{
    ViewData["Title"] = "Stock Movements";

    var products = ViewBag.Products as IEnumerable<InventoryManagementSystem.BLL.DTOs.ProductDTO>;
    var selectedProductId = ViewBag.SelectedProductId as int?;
    var selectedMovementType = ViewBag.SelectedMovementType as StockMovementType?;

    var inTypes = new[]
    {
        StockMovementType.Purchase,
        StockMovementType.Found,
        StockMovementType.OpeningStock,
        StockMovementType.VendorGift,
        StockMovementType.SaleReturn
    };
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1" style="color: #1b2559;">
                Stock Movements
            </h3>

            <p class="text-muted small mb-0">
                Track every change in your inventory quantities
            </p>
        </div>

    </div>


    <!-- Filters -->

    <div class="card border-0 rounded-4 shadow-sm bg-white mb-4">

        <div class="card-body p-3">

            <form asp-action="Index" method="get">

                <div class="row g-2 align-items-center">

                    <div class="col-12 col-md-4">

                        <select name="productId"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="">All Products</option>

                            @if (products != null)
                            {
                                foreach (var p in products)
                                {
                                    <option value="@p.Id"
                                            selected="@(selectedProductId == p.Id)">
                                        @p.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-12 col-md-4">

                        <select name="movementType"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="">All Types</option>

                            @foreach (var type in Enum.GetValues<StockMovementType>())
                            {
                                <option value="@type"
                                        selected="@(selectedMovementType == type)">
                                    @type
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-12 col-md-auto">

                        <a asp-action="Index"
                           class="btn btn-light border rounded-3 w-100">

                            <i class="bi bi-x-lg me-1"></i>
                            Clear Filters

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Movements Table -->

    <div class="card border-0 rounded-4 shadow-sm bg-white">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0" style="color: #1b2559;">
                    Movement History
                </h5>

                <span class="badge rounded-pill px-3 py-2"
                      style="background-color: #e3f2fd; color: #0d47a1;">

                    @Model.Count Movements

                </span>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-borderless align-middle mb-0">

                <thead>

                    <tr class="border-bottom text-muted small">

                        <th class="ps-4">Product</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Date</th>
                        <th>Reference</th>
                        <th>Reason</th>
                        <th class="text-end pe-4">Actions</th>

                    </tr>

                </thead>

                <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="7" class="text-center py-5">

                            <i class="bi bi-arrow-left-right fs-1 text-muted"></i>

                            <h6 class="mt-3 fw-bold">No Movements Found</h6>

                            <p class="text-muted small">
                                There are no stock movements to display.
                            </p>

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var m in Model)
                    {
                        var isIn = inTypes.Contains(m.MovementType);

                        <tr class="border-bottom">

                            <td class="ps-4">

                                <div class="fw-semibold" style="color:#1b2559;">
                                    @m.ProductName
                                </div>

                            </td>

                            <td>

                                <span class="badge rounded-pill px-3 py-2 @(isIn ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger")">
                                    @m.MovementType
                                </span>

                            </td>

                            <td>

                                <span class="fw-semibold @(isIn ? "text-success" : "text-danger")">
                                    @(isIn ? "+" : "-")@m.Quantity
                                </span>

                            </td>

                            <td>

                                <span class="text-muted small">
                                    @m.MovementDate.ToString("dd MMM yyyy HH:mm")
                                </span>

                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(m.ReferenceType))
                                {
                                    <span class="badge rounded-3"
                                          style="background-color:#f3f6fa; color:#1b2559;">

                                        @m.ReferenceType #@m.ReferenceId

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }

                            </td>

                            <td>

                                <span class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(m.Reason) ? "-" : m.Reason)
                                </span>

                            </td>

                            <td class="text-end pe-4">

                                <a asp-action="Details"
                                   asp-route-id="@m.Id"
                                   class="btn btn-sm btn-light rounded-3"
                                   title="Details">

                                    <i class="bi bi-eye text-primary"></i>

                                </a>

                            </td>

                        </tr>
                    }
                }

                </tbody>

            </table>

        </div>

    </div>

</div>
