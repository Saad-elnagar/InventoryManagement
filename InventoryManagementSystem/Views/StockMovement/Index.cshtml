@using InventoryManagementSystem.BLL.DTOs
@using InventoryManagementSystem.BLL.Enums

@model IEnumerable<StockMovementDTO>

@{
    ViewData["Title"] = "Stock Movements";
    

    var products =
        ViewBag.Products as IEnumerable<ProductDTO>
        ?? Enumerable.Empty<ProductDTO>();

    var movementTypes =
        ViewBag.MovementTypes as StockMovementType[]
        ?? Array.Empty<StockMovementType>();
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

       <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Stock Movements
        </h2>

        <p class="text-muted mb-0">
            Track every inventory movement.
        </p>

    </div>

    @if (User.IsInRole("Admin") ||
         User.IsInRole("Manager"))
    {
        <a asp-action="Create"
           class="btn btn-primary rounded-3 px-4">

            <i class="bi bi-plus-lg me-1"></i>
            Add Movement

        </a>
    }

</div>

    </div>


    @{
        var inbound =
            Model
                .Where(x => x.Quantity > 0)
                .Sum(x => x.Quantity);

        var outbound =
            Model
                .Where(x => x.Quantity < 0)
                .Sum(x => Math.Abs(x.Quantity));
    }


    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Total Movements
                </small>

                <h3 class="fw-bold mb-0 mt-2">
                    @Model.Count()
                </h3>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Total Inbound
                </small>

                <h3 class="fw-bold mb-0 mt-2 text-success">
                    +@inbound
                </h3>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Total Outbound
                </small>

                <h3 class="fw-bold mb-0 mt-2 text-danger">
                    -@outbound
                </h3>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Product
                        </label>

                        <select name="productId"
                                class="form-select">

                            <option value="">
                                All Products
                            </option>

                            @foreach (var product in products)
                            {
                                <option value="@product.Id"
                                        selected="@(ViewBag.ProductId == product.Id)">

                                    @product.Name

                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Movement Type
                        </label>

                        <select name="movementType"
                                class="form-select">

                            <option value="">
                                All Types
                            </option>

                            @foreach (var type in movementTypes)
                            {
                                <option value="@type"
                                        selected="@(ViewBag.MovementType == type.ToString())">

                                    @type

                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            From
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@ViewBag.FromDate"
                               class="form-control" />

                    </div>


                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            To
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@ViewBag.ToDate"
                               class="form-control" />

                    </div>


                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">

                            <i class="bi bi-search me-1"></i>
                            Filter

                        </button>

                        <a asp-action="Index"
                           class="btn btn-light border">

                            <i class="bi bi-x-lg"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">

            <h5 class="fw-bold mb-0">
                Movement History
            </h5>

        </div>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                <tr>

                    <th class="ps-4">
                        ID
                    </th>

                    <th>
                        Product
                    </th>

                    <th>
                        Type
                    </th>

                    <th>
                        Quantity
                    </th>

                    <th>
                        Date
                    </th>

                    <th>
                        Reference
                    </th>

                    <th>
                        Reason
                    </th>

                    <th class="text-end pe-4">
                        Action
                    </th>

                </tr>

                </thead>


                <tbody>

                @foreach (var movement in Model)
                {
                    <tr>

                        <td class="ps-4">
                            <span class="fw-bold">
                                #@movement.Id
                            </span>
                        </td>


                        <td>

                            <div class="fw-semibold">

                                @(movement.ProductName
                                    ?? $"Product #{movement.ProductId}")

                            </div>

                            <small class="text-muted">
                                ID: @movement.ProductId
                            </small>

                        </td>


                        <td>

                            @{
                                var typeClass =
                                    movement.MovementType switch
                                    {
                                        nameof(StockMovementType.Purchase)
                                            => "bg-success",

                                        nameof(StockMovementType.Sale)
                                            => "bg-danger",

                                        nameof(StockMovementType.Damage)
                                            => "bg-danger",

                                        nameof(StockMovementType.Lost)
                                            => "bg-danger",

                                        nameof(StockMovementType.Found)
                                            => "bg-success",

                                        nameof(StockMovementType.Adjustment)
                                            => "bg-warning text-dark",

                                        nameof(StockMovementType.PurchaseReturn)
                                            => "bg-danger",

                                        nameof(StockMovementType.SaleReturn)
                                            => "bg-success",

                                        nameof(StockMovementType.OpeningStock)
                                            => "bg-primary",

                                        nameof(StockMovementType.VendorGift)
                                            => "bg-info text-dark",

                                        _ => "bg-secondary"
                                    };
                            }

                            <span class="badge @typeClass">
                                @movement.MovementType
                            </span>

                        </td>


                        <td>

                            @if (movement.Quantity > 0)
                            {
                                <span class="fw-bold text-success">
                                    +@movement.Quantity
                                </span>
                            }
                            else
                            {
                                <span class="fw-bold text-danger">
                                    @movement.Quantity
                                </span>
                            }

                        </td>


                        <td>

                            <span class="small">

                                @movement.MovementDate.ToString(
                                    "yyyy-MM-dd HH:mm")

                            </span>

                        </td>


                        <td>

                            @if (!string.IsNullOrWhiteSpace(
                                movement.ReferenceType))
                            {
                                <span class="small">

                                    @movement.ReferenceType

                                    @if (movement.ReferenceId.HasValue)
                                    {
                                        <text>
                                            #@movement.ReferenceId
                                        </text>
                                    }

                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </td>


                        <td>

                            <span class="small">

                                @(string.IsNullOrWhiteSpace(
                                    movement.Reason)
                                    ? "-"
                                    : movement.Reason)

                            </span>

                        </td>


                        <td class="text-end pe-4">

                            <a asp-action="Details"
                               asp-route-id="@movement.Id"
                               class="btn btn-sm btn-outline-primary">

                                <i class="bi bi-eye"></i>

                            </a>

                        </td>

                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <i class="bi bi-clock-history fs-1 text-muted"></i>

                            <h6 class="mt-3 text-muted">
                                No stock movements found
                            </h6>

                            <p class="text-muted small mb-0">
                                Try changing the filters.
                            </p>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>