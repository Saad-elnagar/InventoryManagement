@model InventoryManagementSystem.Models.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<style>
    .login-box {
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        color: #1f2937;
        text-align: left;
    }

        .login-box * {
            box-sizing: border-box;
        }

        .login-box .login-head {
            text-align: center;
            margin-bottom: 24px;
        }

        .login-box .login-logo {
            width: 44px;
            height: 44px;
            border-radius: 11px;
            background: #0f172a;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
        }

        .login-box .auth-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 4px;
        }

        .login-box .auth-subtitle {
            font-size: .86rem;
            color: #6b7280;
            margin: 0;
        }

        .login-box .login-field {
            margin-bottom: 16px;
        }

        .login-box .login-label {
            display: block;
            font-size: .8rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .login-box .login-input {
            display: block;
            width: 100%;
            height: 44px;
            padding: 0 14px;
            font-family: inherit;
            font-size: .9rem;
            color: #0f172a;
            background: #fff;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .login-box .login-input::placeholder {
                color: #9ca3af;
            }

            .login-box .login-input:focus {
                border-color: #1d63c7;
                box-shadow: 0 0 0 3px rgba(29, 99, 199, .15);
            }

        .login-box .input-validation-error {
            border-color: #ef4444;
        }

        .login-box .pass-wrap {
            position: relative;
        }

            .login-box .pass-wrap .login-input {
                padding-right: 44px;
            }

        .login-box .pass-toggle {
            position: absolute;
            top: 0;
            right: 0;
            height: 44px;
            width: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 0;
            color: #6b7280;
            cursor: pointer;
            border-radius: 8px;
        }

            .login-box .pass-toggle:hover {
                color: #0f172a;
            }

        .login-box .field-error {
            display: block;
            font-size: .75rem;
            color: #dc2626;
            margin-top: 5px;
        }

            .login-box .field-error:empty {
                display: none;
            }

        .login-box .login-alert {
            font-size: .82rem;
            color: #b91c1c;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 16px;
        }

            .login-box .login-alert.validation-summary-valid {
                display: none;
            }

            .login-box .login-alert:empty {
                display: none;
            }

            .login-box .login-alert ul {
                margin: 0;
                padding-left: 16px;
            }

        .login-box .login-btn {
            display: block;
            width: 100%;
            height: 44px;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 8px;
            font-family: inherit;
            font-size: .9rem;
            font-weight: 600;
            color: #fff;
            background: #1d63c7;
            transition: background .15s;
        }

            .login-box .login-btn:hover {
                background: #174f9f;
            }

            .login-box .login-btn:active {
                transform: translateY(1px);
            }

        .login-box .login-footer {
            text-align: center;
            margin-top: 22px;
            font-size: .83rem;
            color: #6b7280;
        }

            .login-box .login-footer a {
                color: #1d63c7;
                font-weight: 600;
                text-decoration: none;
                margin-left: 4px;
            }

                .login-box .login-footer a:hover {
                    text-decoration: underline;
                }
</style>

<div class="login-box">

    <div class="login-head">
        <div class="login-logo">
            <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5 8.186 1.113zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923l6.5 2.6zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464L7.443.184z" />
            </svg>
        </div>

        <h1 class="auth-title">Create account</h1>
        <p class="auth-subtitle">Create your account to access the inventory system.</p>
    </div>

    <form asp-controller="Account"
          asp-action="Register"
          method="post"
          class="auth-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="login-alert"
             role="alert">
        </div>

        <div class="login-field">
            <label asp-for="FullName" class="login-label">Full Name</label>

            <input asp-for="FullName"
                   class="login-input"
                   placeholder="Enter your full name"
                   autocomplete="name" />

            <span asp-validation-for="FullName" class="field-error"></span>
        </div>

        <div class="login-field">
            <label asp-for="Email" class="login-label">Email</label>

            <input asp-for="Email"
                   class="login-input"
                   placeholder="name@company.com"
                   autocomplete="email" />

            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="login-field">
            <label asp-for="Password" class="login-label">Password</label>

            <div class="pass-wrap">
                <input asp-for="Password"
                       class="login-input js-pass"
                       placeholder="Create a password"
                       autocomplete="new-password" />

                <button type="button" class="pass-toggle" aria-label="Show password" tabindex="-1">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                    </svg>
                </button>
            </div>

            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="login-field">
            <label asp-for="ConfirmPassword" class="login-label">Confirm Password</label>

            <div class="pass-wrap">
                <input asp-for="ConfirmPassword"
                       class="login-input js-pass"
                       placeholder="Confirm your password"
                       autocomplete="new-password" />

                <button type="button" class="pass-toggle" aria-label="Show password" tabindex="-1">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                    </svg>
                </button>
            </div>

            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="login-btn">Create Account</button>

    </form>

    <div class="login-footer">
        <span>Already have an account?</span>
        <a asp-controller="Account" asp-action="Login">Sign in</a>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll(".pass-toggle").forEach(function(btn) {
            btn.addEventListener("click", function() {
                var input = btn.parentElement.querySelector(".js-pass");
                if (!input) return;
                var show = input.type === "password";
                input.type = show ? "text" : "password";
                btn.style.color = show ? "#1d63c7" : "";
                btn.setAttribute("aria-label", show ? "Hide password" : "Show password");
            });
        });
    </script>
}
