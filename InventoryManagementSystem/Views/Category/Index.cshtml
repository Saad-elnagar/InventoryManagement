@model InventoryManagementSystem.BLL.Pagination.PaginationResult<InventoryManagementSystem.BLL.DTOs.CategoryDTO>

@{
    ViewData["Title"] = "Categories";
    var search = ViewBag.Search as string;
}

<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Categories</h2>
            <p class="text-muted small m-0">Manage and monitor your category hierarchy</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Add Category</span>
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block text-white-50 small mb-1">Total Categories</span>
                        <h3 class="fw-bold mb-0">@Model.TotalCount</h3>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-3 p-3">
                        <i class="bi bi-tag fs-3 text-white"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block text-muted small mb-1">Active Categories</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalCount</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block text-muted small mb-1">System Status</span>
                        <h3 class="fw-bold mb-0 text-dark">Updated</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                        <i class="bi bi-arrow-repeat fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-2">
        <form asp-action="Index" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-transparent ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control border-0 shadow-none ps-2"
                               placeholder="Search by category name or description..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-light rounded-3">Clear</a>
                    </div>
                }
            </div>
        </form>
    </div>

    <!-- Category List Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">Category List</h5>
            <span class="badge bg-light text-primary fs-6 px-3 py-2 rounded-pill">@Model.TotalCount Categories</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Category</th>
                        <th>Description</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Data.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                No categories found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-tag-fill fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">@item.Name</h6>
                                            <span class="text-muted small">#@item.Id</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrEmpty(item.Description) ? "N/A" : item.Description)</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Active</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary rounded-circle" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-warning rounded-circle" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger rounded-circle" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            }
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Page @Model.Page of @Model.TotalPages</small>
                    <nav aria-label="Category pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.Page - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-search="@search"
                                   aria-label="Previous page">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-search="@search">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.Page + 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-search="@search"
                                   aria-label="Next page">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>
