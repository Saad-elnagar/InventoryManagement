@model IEnumerable<InventoryManagementSystem.BLL.DTOs.CategoryDTO>

@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid px-4 py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-dark m-0">
                Categories
            </h2>

            <p class="text-muted small m-0">
                Manage and monitor your category hierarchy
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">

            <i class="bi bi-plus-lg me-2"></i>

            Add Category

        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="d-block text-muted small mb-1">
                            Total Categories
                        </span>

                        <h3 class="fw-bold mb-0">
                            @Model.Count()
                        </h3>

                    </div>

                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">

                        <i class="bi bi-tag fs-3"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="d-block text-muted small mb-1">
                            Active Categories
                        </span>

                        <h3 class="fw-bold mb-0 text-success">
                            @Model.Count()
                        </h3>

                    </div>

                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">

                        <i class="bi bi-check-circle fs-3"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="d-block text-muted small mb-1">
                            System Status
                        </span>

                        <h3 class="fw-bold mb-0">
                            Updated
                        </h3>

                    </div>

                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">

                        <i class="bi bi-arrow-repeat fs-3"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-2">

            <div class="input-group">

                <span class="input-group-text border-0 bg-transparent ps-3">

                    <i class="bi bi-search text-muted"></i>

                </span>

                <input type="text"
                       id="categorySearch"
                       class="form-control border-0 shadow-none"
                       placeholder="Search by category name or description..." />

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 py-3 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0 text-dark">
                    Category List
                </h5>

                <span class="badge bg-light text-primary fs-6 px-3 py-2 rounded-pill">
                    @Model.Count() Categories
                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="bg-light text-muted small text-uppercase">

                <tr>

                    <th class="ps-4">
                        Category
                    </th>

                    <th>
                        Description
                    </th>

                    <th class="text-center">
                        Status
                    </th>

                    <th class="text-end pe-4">
                        Actions
                    </th>

                </tr>

                </thead>

                <tbody id="categoryTableBody">

                @foreach (var item in Model)
                {
                    <tr class="category-row">

                        <td class="ps-4">

                            <div class="d-flex align-items-center gap-3">

                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px;">

                                    <i class="bi bi-tag-fill fs-5"></i>

                                </div>

                                <div>

                                    <h6 class="fw-bold mb-0 category-name">
                                        @item.Name
                                    </h6>

                                    <span class="text-muted small">
                                        #@item.Id
                                    </span>

                                </div>

                            </div>

                        </td>

                        <td>

                            <span class="text-secondary small category-description">

                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "N/A"
                                    : item.Description)

                            </span>

                        </td>

                        <td class="text-center">

                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                Active
                            </span>

                        </td>

                        <td class="text-end pe-4">

                            <div class="d-flex justify-content-end gap-1">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light text-primary rounded-circle"
                                   title="Details">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light text-warning rounded-circle"
                                   title="Edit">

                                    <i class="bi bi-pencil"></i>

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light text-danger rounded-circle"
                                   title="Delete">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

        <div id="noResults"
             class="text-center py-5 d-none">

            <i class="bi bi-search fs-1 text-muted"></i>

            <h5 class="fw-bold mt-3">
                No categories found
            </h5>

            <p class="text-muted mb-0">
                Try another search term.
            </p>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const searchInput =
                    document.getElementById("categorySearch");

                const rows =
                    document.querySelectorAll(".category-row");

                const noResults =
                    document.getElementById("noResults");

                searchInput.addEventListener(
                    "input",
                    function () {

                        const search =
                            this.value
                                .trim()
                                .toLowerCase();

                        let visibleRows = 0;

                        rows.forEach(function (row) {

                            const name =
                                row.querySelector(
                                    ".category-name"
                                )?.textContent
                                .trim()
                                .toLowerCase() ?? "";

                            const description =
                                row.querySelector(
                                    ".category-description"
                                )?.textContent
                                .trim()
                                .toLowerCase() ?? "";

                            const matches =
                                name.includes(search) ||
                                description.includes(search);

                            row.style.display =
                                matches ? "" : "none";

                            if (matches) {
                                visibleRows++;
                            }

                        });

                        noResults.classList.toggle(
                            "d-none",
                            visibleRows !== 0
                        );

                    });

            });

    </script>
}