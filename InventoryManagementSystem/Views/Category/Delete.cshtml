@model InventoryManagementSystem.BLL.DTOs.CategoryDTO

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container-fluid px-4 py-4" style="max-width: 700px;">

    <div class="mb-3">

        <a asp-action="Index"
           class="text-decoration-none text-muted small fw-medium">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Categories

        </a>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="text-center mb-4">

                <div class="bg-danger bg-opacity-10 text-danger rounded-circle
                            d-inline-flex align-items-center justify-content-center"
                     style="width:80px;height:80px;">

                    <i class="bi bi-trash fs-1"></i>

                </div>

                <h3 class="fw-bold mt-3">
                    Delete Category?
                </h3>

                <p class="text-muted mb-0">
                    You are about to delete this category.
                </p>

            </div>

            <div class="bg-light rounded-4 p-4 mb-4">

                <div class="mb-3">

                    <small class="text-muted d-block">
                        ID
                    </small>

                    <span class="fw-bold">
                        #@Model.Id
                    </span>

                </div>

                <div class="mb-3">

                    <small class="text-muted d-block">
                        Name
                    </small>

                    <span class="fw-bold">
                        @Model.Name
                    </span>

                </div>

                <div>

                    <small class="text-muted d-block">
                        Description
                    </small>

                    <span>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description"
                            : Model.Description)
                    </span>

                </div>

            </div>

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light border px-4">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash me-1"></i>
                        Delete Category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>