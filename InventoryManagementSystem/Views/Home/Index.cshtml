@model InventoryManagementSystem.BLL.DTOs.DashboardDTO
@using System.Text.Json

@{
ViewData["Title"] = "Inventory Dashboard";

var hasMovementData =
Model.StockMovements.Any(x =>
x.Inbound > 0 ||
x.Outbound > 0);

var hasCategoryData =
Model.CategoryStatistics.Any(x =>
x.ProductCount > 0);

var categoryColors = new[]
{
"#FF6B6B",
"#4D96FF",
"#6BCB77",
"#FFD93D",
"#845EC2",
"#FF9671"
};
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1" style="color: #1b2559;">
                Inventory Dashboard
            </h3>

            <p class="text-muted small mb-0">
                @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </p>
        </div>

        <div class="d-flex align-items-center gap-3">

            <button class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                    style="width:40px;height:40px;">
                <i class="bi bi-search"></i>
            </button>

            <button class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                    style="width:40px;height:40px;">
                <i class="bi bi-envelope"></i>
            </button>

            <div class="d-flex align-items-center gap-2">

                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width:40px;height:40px;">
                    JR
                </div>

                <div>
                    <div class="fw-bold small">
                        Admin
                    </div>

                    <small class="text-muted" style="font-size:11px;">
                        Group Admin
                    </small>
                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">

        <div class="col-12 col-xl-8">

            <div class="row g-3 mb-4">

                <div class="col-12 col-sm-6">

                    <div class="card border-0 rounded-4 p-3 shadow-sm text-white h-100"
                         style="background-color:#0d47a1;">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="px-3 py-1 rounded-pill fw-bold"
                                  style="background-color:rgba(255,255,255,.18);font-size:12px;">
                                Sales
                            </span>

                            <div class="rounded-3 d-flex align-items-center justify-content-center"
                                 style="background-color:rgba(255,255,255,.18);width:38px;height:38px;">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>

                        </div>

                        <div class="small mb-1"
                             style="color:rgba(255,255,255,.7);">
                            Total Sales
                        </div>

                        <h3 class="fw-bold mb-0">
                            EGP @Model.TotalSales.ToString("N0")
                        </h3>

                    </div>

                </div>


                <div class="col-12 col-sm-6">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="px-3 py-1 rounded-pill fw-bold"
                                  style="background-color:#e8f5e9;color:#2e7d32;font-size:12px;">
                                Purchases
                            </span>

                            <div class="rounded-3 d-flex align-items-center justify-content-center"
                                 style="background-color:#e3f2fd;width:38px;height:38px;">
                                <i class="bi bi-cart-plus text-primary"></i>
                            </div>

                        </div>

                        <div class="text-muted small mb-1">
                            Total Purchases
                        </div>

                        <h3 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            EGP @Model.TotalPurchases.ToString("N0")
                        </h3>

                    </div>

                </div>


                <div class="col-12 col-sm-6">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="px-3 py-1 rounded-pill fw-bold"
                                  style="background-color:#e3f2fd;color:#1976d2;font-size:12px;">
                                Stock
                            </span>

                            <div class="rounded-3 d-flex align-items-center justify-content-center"
                                 style="background-color:#e3f2fd;width:38px;height:38px;">
                                <i class="bi bi-box-seam text-primary"></i>
                            </div>

                        </div>

                        <div class="text-muted small mb-1">
                            Total Stock
                        </div>

                        <h3 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            @Model.TotalStock.ToString("N0")
                        </h3>

                    </div>

                </div>


                <div class="col-12 col-sm-6">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="px-3 py-1 rounded-pill fw-bold"
                                  style="background-color:#ffebee;color:#c62828;font-size:12px;">
                                Alert
                            </span>

                            <div class="rounded-3 d-flex align-items-center justify-content-center"
                                 style="background-color:#ffebee;width:38px;height:38px;">
                                <i class="bi bi-exclamation-triangle text-danger"></i>
                            </div>

                        </div>

                        <div class="text-muted small mb-1">
                            Low Stock
                        </div>

                        <h3 class="fw-bold mb-0 text-danger">
                            @Model.LowStockProducts
                        </h3>

                    </div>

                </div>

            </div>


            <div class="row g-3 mb-4">

                <div class="col-12 col-md-4">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <small class="text-muted">
                            Products
                        </small>

                        <h5 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            @Model.TotalProducts
                        </h5>

                    </div>

                </div>


                <div class="col-12 col-md-4">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <small class="text-muted">
                            Categories
                        </small>

                        <h5 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            @Model.TotalCategories
                        </h5>

                    </div>

                </div>


                <div class="col-12 col-md-4">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <small class="text-muted">
                            Inventory Value
                        </small>

                        <h6 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            EGP @Model.InventoryValue.ToString("N0")
                        </h6>

                    </div>

                </div>

            </div>


            <div class="row g-3 mb-4">

                <div class="col-12 col-md-6">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <small class="text-muted">
                            Suppliers
                        </small>

                        <h5 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            @Model.TotalSuppliers
                        </h5>

                    </div>

                </div>


                <div class="col-12 col-md-6">

                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">

                        <small class="text-muted">
                            Customers
                        </small>

                        <h5 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            @Model.TotalCustomers
                        </h5>

                    </div>

                </div>

            </div>


            <div class="card border-0 rounded-4 p-4 shadow-sm bg-white">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h5 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            Inventory Movement
                        </h5>

                        <small class="text-muted">
                            Real stock movement during @DateTime.Now.Year
                        </small>

                    </div>

                    <span class="badge bg-light text-dark px-3 py-2">
                        @DateTime.Now.Year
                    </span>

                </div>


                @if (hasMovementData)
                {
                <div style="height:300px;">
                    <canvas id="inventoryBarChart"></canvas>
                </div>
                }
                else
                {
                <div class="d-flex align-items-center justify-content-center"
                     style="height:300px;">

                    <div class="text-center">

                        <i class="bi bi-bar-chart-line fs-1 text-muted"></i>

                        <h6 class="mt-3 text-muted">
                            No stock movement data
                        </h6>

                        <small class="text-muted">
                            Purchases and sales will appear here
                            after stock movements are recorded.
                        </small>

                    </div>

                </div>
                }

            </div>

        </div>


        <div class="col-12 col-xl-4 d-flex flex-column gap-4">


            <div class="card border-0 rounded-4 p-4 shadow-sm"
                 style="background-color:#eef2f7;">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <h5 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            Category Statistics
                        </h5>

                        <small class="text-muted">
                            Products by category
                        </small>

                    </div>

                </div>


                @if (hasCategoryData)
                {
                <div class="position-relative d-flex justify-content-center align-items-center my-3"
                     style="height:220px;">

                    <canvas id="categoryDoughnutChart"></canvas>

                    <div class="position-absolute text-center">

                            <span class="d-block text-muted small">
                                Total Products
                            </span>

                        <span class="fw-bold fs-3"
                              style="color:#1b2559;">
                                @Model.TotalProducts
                            </span>

                    </div>

                </div>


                <div class="d-flex flex-column gap-3 mt-3">

                    @for (int i = 0;
                    i < Math.Min(
                    Model.CategoryStatistics.Count,
                    categoryColors.Length);
                    i++)
                    {
                    var category =
                    Model.CategoryStatistics[i];

                    var color =
                    categoryColors[i];

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center gap-2">

                                    <span style="
                                        width:14px;
                                        height:14px;
                                        min-width:14px;
                                        display:inline-block;
                                        border-radius:4px;
                                        background-color:@color;
                                        border:2px solid white;
                                        box-shadow:0 1px 4px rgba(0,0,0,0.2);
                                        "></span>

                            <span class="fw-semibold"
                                  style="color:#1b2559;">
                                        @category.CategoryName
                                    </span>

                        </div>

                        <span class="fw-bold"
                              style="color:#1b2559;">
                                    @category.ProductCount
                                </span>

                    </div>
                    }

                </div>
                }
                else
                {
                <div class="text-center py-5">

                    <i class="bi bi-pie-chart fs-1 text-muted"></i>

                    <div class="mt-2 fw-semibold text-muted">
                        No category data available
                    </div>

                </div>
                }

            </div>


            <div class="card border-0 rounded-4 p-3 shadow-sm bg-white">

                <div class="mb-3">

                    <h6 class="fw-bold mb-0"
                        style="color:#1b2559;">
                        Stock Overview
                    </h6>

                    <small class="text-muted">
                        Products requiring attention
                    </small>

                </div>


                <div class="table-responsive">

                    <table class="table table-borderless align-middle mb-0 small">

                        <thead>

                        <tr class="text-muted border-bottom">

                            <th>Product</th>
                            <th>Qty</th>
                            <th>Status</th>

                        </tr>

                        </thead>

                        <tbody>

                        @foreach (var product in Model.Products)
                        {
                        <tr>

                            <td>
                                @product.Name
                            </td>

                            <td>
                                @product.Quantity
                            </td>

                            <td>

                                @if (product.Status == "Available")
                                {
                                <span class="badge bg-success bg-opacity-10 text-success">
                                                Available
                                            </span>
                                }
                                else if (product.Status == "Low")
                                {
                                <span class="badge bg-warning bg-opacity-25 text-warning">
                                                Low
                                            </span>
                                }
                                else
                                {
                                <span class="badge bg-danger bg-opacity-10 text-danger">
                                                Out
                                            </span>
                                }

                            </td>

                        </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="card border-0 rounded-4 p-3 shadow-sm bg-white">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <h6 class="fw-bold mb-0"
                            style="color:#1b2559;">
                            Stock Status
                        </h6>

                        <small class="text-muted">
                            Current inventory condition
                        </small>

                    </div>

                </div>


                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-2"
                     style="background:#fff5f5;">

                    <div class="d-flex align-items-center gap-2">

                        <div class="rounded-circle bg-danger"
                             style="width:10px;height:10px;">
                        </div>

                        <span class="text-muted">
                            Out Of Stock
                        </span>

                    </div>

                    <span class="fw-bold text-danger">
                        @Model.OutOfStockProducts
                    </span>

                </div>


                <div class="d-flex justify-content-between align-items-center p-3 rounded-3"
                     style="background:#fff9ed;">

                    <div class="d-flex align-items-center gap-2">

                        <div class="rounded-circle bg-warning"
                             style="width:10px;height:10px;">
                        </div>

                        <span class="text-muted">
                            Low Stock
                        </span>

                    </div>

                    <span class="fw-bold text-warning">
                        @Model.LowStockProducts
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const categoryColors = [
            "#FF6B6B",
            "#4D96FF",
            "#6BCB77",
            "#FFD93D",
            "#845EC2",
            "#FF9671"
        ];


        const inventoryCanvas =
            document.getElementById("inventoryBarChart");

        if (inventoryCanvas) {

            new Chart(inventoryCanvas, {

                type: "bar",

                data: {

                    labels:
                    @Html.Raw(
                    JsonSerializer.Serialize(
                    Model.StockMovements
                    .Select(x => x.Month)
                    )
                    ),

                    datasets: [

                        {
                            label: "Inbound",

                            data:
                            @Html.Raw(
                            JsonSerializer.Serialize(
                            Model.StockMovements
                            .Select(x => x.Inbound)
                            )
                            ),

                            backgroundColor: "#4D96FF",

                            borderColor: "#1E5BB8",

                            borderWidth: 1,

                            borderRadius: 7,

                            barPercentage: 0.65,

                            categoryPercentage: 0.65
                        },

                        {
                            label: "Outbound",

                            data:
                            @Html.Raw(
                            JsonSerializer.Serialize(
                            Model.StockMovements
                            .Select(x => x.Outbound)
                            )
                            ),

                            backgroundColor: "#FF6B6B",

                            borderColor: "#D94A4A",

                            borderWidth: 1,

                            borderRadius: 7,

                            barPercentage: 0.65,

                            categoryPercentage: 0.65
                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {

                            display: true,

                            position: "bottom",

                            labels: {

                                usePointStyle: true,

                                boxWidth: 12,

                                padding: 18

                            }

                        }

                    },

                    scales: {

                        x: {

                            grid: {
                                display: false
                            },

                            ticks: {
                                color: "#555"
                            }

                        },

                        y: {

                            beginAtZero: true,

                            grid: {
                                color: "#dfe5ef"
                            },

                            ticks: {
                                color: "#555"
                            }

                        }

                    }

                }

            });

        }


        const categoryCanvas =
            document.getElementById("categoryDoughnutChart");

        if (categoryCanvas) {

            new Chart(categoryCanvas, {

                type: "doughnut",

                data: {

                    labels:
                    @Html.Raw(
                    JsonSerializer.Serialize(
                    Model.CategoryStatistics
                    .Select(x => x.CategoryName)
                    )
                    ),

                    datasets: [

                        {
                            data:
                            @Html.Raw(
                            JsonSerializer.Serialize(
                            Model.CategoryStatistics
                            .Select(x => x.ProductCount)
                            )
                            ),

                            backgroundColor: categoryColors,

                            borderColor: "#FFFFFF",

                            borderWidth: 3,

                            hoverOffset: 10
                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "65%",

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {

                            enabled: true,

                            callbacks: {

                                label: function (context) {

                                    const label =
                                        context.label || "";

                                    const value =
                                        context.raw || 0;

                                    return label + ": " + value;

                                }

                            }

                        }

                    }

                }

            });

        }

    });

</script>
}