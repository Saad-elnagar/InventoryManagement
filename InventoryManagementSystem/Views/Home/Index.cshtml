@{
    ViewData["Title"] = "Sales Report";
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1b2559;">Sales Report</h3>
            <p class="text-muted small mb-0">Friday, December 12, 2025</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light rounded-circle p-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
            <button class="btn btn-light rounded-circle p-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </button>
            <div class="d-flex align-items-center gap-2">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                    JR
                </div>
                <div>
                    <div class="fw-bold small lh-1">John Rees</div>
                    <small class="text-muted" style="font-size: 11px;">Group Admin</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Grid Layout -->
    <div class="row g-4">
        <!-- Left Section (Top Cards + Inventory Chart) -->
        <div class="col-12 col-xl-8">
            <!-- 4 Top Cards Grid -->
            <div class="row g-3 mb-4">
                <!-- Card 1: Total Sales -->
                <div class="col-12 col-sm-6">
                    <div class="card border-0 rounded-4 p-3 shadow-sm text-white h-100" style="background-color: #0d47a1;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="px-3 py-1 fw-bold rounded-pill" style="background-color: rgba(255, 255, 255, 0.2); color: #ffffff; font-size: 13px;">+20.9%</span>
                            <div class="d-flex align-items-center justify-content-center rounded-3 p-2" style="background-color: rgba(255, 255, 255, 0.2); width: 38px; height: 38px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                            </div>
                        </div>
                        <div class="small mb-1" style="color: rgba(255, 255, 255, 0.7);">Total Sales</div>
                        <h3 class="fw-bold mb-0 text-white">EGP 619,000</h3>
                    </div>
                </div>

                <!-- Card 2: Total Orders -->
                <div class="col-12 col-sm-6">
                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="px-3 py-1 fw-bold rounded-pill" style="background-color: #e8f5e9; color: #2e7d32; font-size: 13px;">+10.9%</span>
                            <div class="d-flex align-items-center justify-content-center rounded-3 p-2" style="background-color: #e3f2fd; width: 38px; height: 38px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1976d2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                            </div>
                        </div>
                        <div class="text-muted small mb-1">Total Orders</div>
                        <h3 class="fw-bold mb-0" style="color: #1b2559;">1,000</h3>
                    </div>
                </div>

                <!-- Card 3: Total products sold -->
                <div class="col-12 col-sm-6">
                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="px-3 py-1 fw-bold rounded-pill" style="background-color: #e8f5e9; color: #2e7d32; font-size: 13px;">+20%</span>
                            <div class="d-flex align-items-center justify-content-center rounded-3 p-2" style="background-color: #e3f2fd; width: 38px; height: 38px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1976d2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                            </div>
                        </div>
                        <div class="text-muted small mb-1">Total products sold</div>
                        <h3 class="fw-bold mb-0" style="color: #1b2559;">3,000</h3>
                    </div>
                </div>

                <!-- Card 4: Total operations -->
                <div class="col-12 col-sm-6">
                    <div class="card border-0 rounded-4 p-3 shadow-sm bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="px-3 py-1 fw-bold rounded-pill" style="background-color: #ffebee; color: #c62828; font-size: 13px;">-5.0%</span>
                            <div class="d-flex align-items-center justify-content-center rounded-3 p-2" style="background-color: #e3f2fd; width: 38px; height: 38px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1976d2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </div>
                        </div>
                        <div class="text-muted small mb-1">Total operations</div>
                        <h3 class="fw-bold mb-0" style="color: #1b2559;">2,003</h3>
                    </div>
                </div>
            </div>

            <!-- Inventory Movement Chart Card -->
            <div class="card border-0 rounded-4 p-4 shadow-sm bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-0" style="color: #1b2559;">Inventory Movement</h5>
                        <small class="text-muted">Monthly Inbound Vs. Outbound</small>
                    </div>
                    <select class="form-select form-select-sm w-auto border-0 bg-light rounded-3 fw-semibold">
                        <option>This Year</option>
                    </select>
                </div>
                <div style="height: 300px; position: relative;">
                    <canvas id="inventoryBarChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Right Section (Category Statistics + Products Table) -->
        <div class="col-12 col-xl-4 d-flex flex-column gap-4">
            <!-- Category Statistics Card -->
            <div class="card border-0 rounded-4 p-4 shadow-sm text-white" style="background-color: #8fa2c7;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Category Statistics</h5>
                        <small class="text-secondary" style="font-size: 11px;">Track Sales For Each Category.</small>
                    </div>
                    <select class="form-select form-select-sm w-auto border-0 bg-white bg-opacity-50 text-dark fw-semibold rounded-3">
                        <option>Today</option>
                    </select>
                </div>

                <div class="position-relative d-flex justify-content-center align-items-center my-3" style="height: 180px;">
                    <canvas id="categoryDoughnutChart"></canvas>
                    <div class="position-absolute text-center">
                        <span class="d-block text-white-50 small lh-1">Total units</span>
                        <span class="fw-bold fs-4 text-white">5778</span>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2 mt-2 small">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-1" style="width: 12px; height: 12px; background-color: #64b5f6;"></span>
                            <span class="text-dark">Electricity</span>
                        </div>
                        <span class="fw-semibold text-dark">1,463</span>
                        <span class="badge bg-danger bg-opacity-75">-2.4%</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-1" style="width: 12px; height: 12px; background-color: #1976d2;"></span>
                            <span class="text-dark">Paints</span>
                        </div>
                        <span class="fw-semibold text-dark">1,828</span>
                        <span class="badge bg-success bg-opacity-75">+3.8%</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-1" style="width: 12px; height: 12px; background-color: #0d47a1;"></span>
                            <span class="text-dark">Construction Materials</span>
                        </div>
                        <span class="fw-semibold text-dark">2,487</span>
                        <span class="badge bg-success bg-opacity-75">+3.4%</span>
                    </div>
                </div>
            </div>

            <!-- Products Table Card -->
            <div class="card border-0 rounded-4 p-3 shadow-sm bg-white">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0 small">
                        <thead>
                            <tr class="text-muted border-bottom">
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Quantity</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>12mm reinforcing steel bar</td>
                                <td class="text-muted">WH-2041</td>
                                <td>1250</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success fw-normal">Available</span></td>
                            </tr>
                            <tr>
                                <td>Portland cement</td>
                                <td class="text-muted">WH-2042</td>
                                <td>48</td>
                                <td><span class="badge bg-warning bg-opacity-20 text-warning fw-normal">Low</span></td>
                            </tr>
                            <tr>
                                <td>Chrome water mixer</td>
                                <td class="text-muted">WH-2043</td>
                                <td>0</td>
                                <td><span class="badge bg-danger bg-opacity-10 text-danger fw-normal">Out Of Stock</span></td>
                            </tr>
                            <tr>
                                <td>18mm MDF</td>
                                <td class="text-muted">WH-2044</td>
                                <td>76</td>
                                <td><span class="badge bg-warning bg-opacity-20 text-warning fw-normal">Low</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <!-- استدعاء مكتبة Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Inventory Movement Bar Chart
            const ctxBar = document.getElementById('inventoryBarChart');
            if (ctxBar) {
                new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [
                            {
                                label: 'Imported',
                                data: { Jan: 28000, Feb: 65000, Mar: 20000, Apr: 85000, May: 25000, Jun: 72000 },
                                backgroundColor: '#64b5f6',
                                borderRadius: 6,
                                barPercentage: 0.6,
                                categoryPercentage: 0.5
                            },
                            {
                                label: 'Outgoing',
                                data: { Jan: 78000, Feb: 55000, Mar: 25000, Apr: 75000, May: 5000, Jun: 30000 },
                                backgroundColor: '#0d47a1',
                                borderRadius: 6,
                                barPercentage: 0.6,
                                categoryPercentage: 0.5
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, usePointStyle: true }
                            }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                grid: { color: '#f0f0f0' },
                                ticks: {
                                    callback: function(value) {
                                        return value >= 1000 ? (value/1000) + 'K' : value;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Category Statistics Doughnut Chart
            const ctxDoughnut = document.getElementById('categoryDoughnutChart');
            if (ctxDoughnut) {
                new Chart(ctxDoughnut, {
                    type: 'doughnut',
                    data: {
                        labels: ['Electricity', 'Paints', 'Construction Materials'],
                        datasets: [{
                            data: [1463, 1828, 2487],
                            backgroundColor: ['#64b5f6', '#1976d2', '#0d47a1'],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '75%',
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}