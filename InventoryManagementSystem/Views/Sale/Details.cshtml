@model InventoryManagementSystem.BLL.DTOs.SaleDTO

@{
    ViewData["Title"] = "Sale Details";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none text-muted">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Sales

        </a>

        <h2 class="fw-bold mt-3 mb-1">
            Sale #@Model.Id
        </h2>

        <p class="text-muted mb-0">
            Sale details and items.
        </p>

    </div>


    <div class="row g-4">

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Sale Information
                    </h5>


                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Customer
                        </small>

                        <span class="fw-semibold">

                            @(Model.CustomerName
                              ?? $"Customer #{Model.CustomerId}")

                        </span>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Customer ID
                        </small>

                        <span class="fw-semibold">
                            @Model.CustomerId
                        </span>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Sale Date
                        </small>

                        <span class="fw-semibold">
                            @Model.SaleDate.ToString(
                                "yyyy-MM-dd HH:mm")
                        </span>

                    </div>


                    <div>

                        <small class="text-muted d-block">
                            Total Amount
                        </small>

                        <span class="fw-bold text-success fs-4">
                            EGP @Model.TotalAmount.ToString("N2")
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Sale Items
                            </h5>

                            <small class="text-muted">
                                @Model.Items.Count item(s)
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Product
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th>
                                    Unit Price
                                </th>

                                <th class="text-end pe-4">
                                    Total
                                </th>

                            </tr>

                            </thead>


                            <tbody>

                            @foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @(item.ProductName
                                              ?? $"Product #{item.ProductId}")
                                        </div>

                                        <small class="text-muted">
                                            ID: @item.ProductId
                                        </small>

                                    </td>


                                    <td>
                                        @item.Quantity
                                    </td>


                                    <td>
                                        EGP @item.UnitPrice.ToString("N2")
                                    </td>


                                    <td class="text-end pe-4">

                                        <span class="fw-bold">
                                            EGP @item.Total.ToString("N2")
                                        </span>

                                    </td>

                                </tr>
                            }

                            </tbody>


                            <tfoot>

                            <tr>

                                <td colspan="3"
                                    class="text-end fw-bold">

                                    Grand Total

                                </td>

                                <td class="text-end pe-4">

                                    <span class="fw-bold text-success fs-5">

                                        EGP @Model.TotalAmount.ToString("N2")

                                    </span>

                                </td>

                            </tr>

                            </tfoot>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>