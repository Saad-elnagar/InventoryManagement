@model InventoryManagementSystem.BLL.DTOs.SaleDTO

@{
    ViewData["Title"] = "Add New Sale";
}

<div class="container-fluid px-4 py-4" style="max-width: 900px;">
    <!-- Back Button Link -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small fw-medium">
            <i class="bi bi-arrow-left me-1"></i> Back to Sales
        </a>
    </div>

    <!-- Header Section -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark m-0">Add New Sale</h2>
        <p class="text-muted small m-0">Create a new sales record in your inventory system.</p>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Customer ID Input -->
            <div class="mb-4">
                <label asp-for="CustomerId" class="form-label fw-semibold text-dark">Customer ID</label>
                <input asp-for="CustomerId" type="number" class="form-control form-control-lg rounded-3 fs-6" placeholder="Enter Customer ID" />
                <span asp-validation-for="CustomerId" class="text-danger small"></span>
            </div>

            <!-- Total Amount Input -->
            <div class="mb-4">
                <label asp-for="TotalAmount" class="form-label fw-semibold text-dark">Total Amount</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">$</span>
                    <input asp-for="TotalAmount" type="number" step="0.01" class="form-control rounded-3 fs-6 border-start-0" placeholder="0.00" />
                </div>
                <span asp-validation-for="TotalAmount" class="text-danger small"></span>
            </div>

            <!-- Sale Date Input -->
            <div class="mb-4">
                <label asp-for="SaleDate" class="form-label fw-semibold text-dark">Sale Date</label>
                <input asp-for="SaleDate" type="datetime-local" class="form-control rounded-3 fs-6" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="SaleDate" class="text-danger small"></span>
            </div>

            <!-- Form Actions -->
            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-2">
                <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-medium">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-medium d-inline-flex align-items-center gap-2">
                    <i class="bi bi-check-lg"></i>
                    <span>Create Sale</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}