@model IEnumerable<InventoryManagementSystem.BLL.DTOs.SaleDTO>

@{
    ViewData["Title"] = "Sales";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Sales</h2>
            <p class="text-muted small m-0">Manage and monitor sales orders and history</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Add Sale</span>
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block text-white-50 small mb-1">Total Sales</span>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-3 p-3">
                        <i class="bi bi-cart-check fs-3 text-white"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block text-muted small mb-1">Total Revenue</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.Sum(s => s.TotalAmount).ToString("C")</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-currency-dollar fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block text-muted small mb-1">System Status</span>
                        <h3 class="fw-bold mb-0 text-dark">Updated</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                        <i class="bi bi-arrow-repeat fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group input-group-merge">
                    <span class="input-group-text border-0 bg-transparent ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="salesSearch" class="form-control border-0 shadow-none ps-2" placeholder="Search by customer ID or sale ID...">
                </div>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100 rounded-3">Search</button>
            </div>
        </div>
    </div>

    <!-- Sales List Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">Sales Orders</h5>
            <span class="badge bg-light text-primary fs-6 px-3 py-2 rounded-pill">@Model.Count() Records</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Sale ID</th>
                        <th>Customer ID</th>
                        <th>Sale Date</th>
                        <th>Total Amount</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-receipt fs-5"></i>
                                    </div>
                                    <span class="fw-bold text-dark">#@item.Id</span>
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">Customer #@item.CustomerId</span>
                            </td>
                            <td>
                                <span class="text-secondary small">@item.SaleDate.ToString("yyyy-MM-dd HH:mm")</span>
                            </td>
                            <td>
                                <span class="fw-bold text-success">@item.TotalAmount.ToString("C")</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Completed</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary rounded-circle" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger rounded-circle" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>