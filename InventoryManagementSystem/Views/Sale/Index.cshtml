@model IEnumerable<InventoryManagementSystem.BLL.DTOs.SaleDTO>

@{
    ViewData["Title"] = "Sales";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Sales
            </h2>

            <p class="text-muted mb-0">
                Manage sales and inventory transactions.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary rounded-3 px-4">

            <i class="bi bi-plus-lg me-1"></i>
            Add Sale

        </a>

    </div>


    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Total Sales
                </small>

                <h3 class="fw-bold mt-2 mb-0">
                    @Model.Count()
                </h3>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Total Revenue
                </small>

                <h3 class="fw-bold mt-2 mb-0 text-success">
                    EGP @Model.Sum(x => x.TotalAmount).ToString("N2")
                </h3>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <small class="text-muted">
                    Status
                </small>

                <h3 class="fw-bold mt-2 mb-0 text-success">
                    Active
                </h3>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                    <tr>

                        <th class="ps-4">
                            Sale ID
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Total
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-end pe-4">
                            Actions
                        </th>

                    </tr>

                    </thead>

                    <tbody>

                    @foreach (var sale in Model)
                    {
                        <tr>

                            <td class="ps-4">

                                <span class="fw-bold">
                                    #@sale.Id
                                </span>

                            </td>


                            <td>

                                <div class="fw-semibold">
                                    @(sale.CustomerName
                                      ?? $"Customer #{sale.CustomerId}")
                                </div>

                                <small class="text-muted">
                                    ID: @sale.CustomerId
                                </small>

                            </td>


                            <td>

                                @sale.SaleDate.ToString(
                                    "yyyy-MM-dd HH:mm")

                            </td>


                            <td>

                                <span class="fw-bold text-success">
                                    EGP @sale.TotalAmount.ToString("N2")
                                </span>

                            </td>


                            <td class="text-center">

                                <span class="badge bg-success">
                                    Completed
                                </span>

                            </td>


                            <td class="text-end pe-4">

                                <a asp-action="Details"
                                   asp-route-id="@sale.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye me-1"></i>
                                    Details

                                </a>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>