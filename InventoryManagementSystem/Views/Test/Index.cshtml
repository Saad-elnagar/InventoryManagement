@model IEnumerable<InventoryManagementSystem.DAL.Entities.Product>

@{
    ViewData["Title"] = "Product List";
}

<div class="container mt-4">
    <h2>Product Inventory List</h2>
    <hr />

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
        <tr>
            <th>SKU</th>
            <th>Product Name</th>
            <th>Unit Price</th>
            <th>Stock Quantity</th>
            <th>Low Stock Threshold</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sku</td>
                <td>@item.ProductName</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>
                    @* Highlighting low stock items based on system requirements *@
                    @if (item.StockQuantity <= item.LowStockThreshold)
                    {
                        <span class="text-danger fw-bold">@item.StockQuantity (Low Stock!)</span>
                    }
                    else
                    {
                        <span class="text-success">@item.StockQuantity</span>
                    }
                </td>
                <td>@item.LowStockThreshold</td>
            </tr>
        }
        </tbody>
    </table>
</div>