@model InventoryManagementSystem.BLL.DTOs.DashboardDTO
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";

    int total = Model.TotalProducts;
    int low = Model.LowStockProducts;
    int out_ = Model.OutOfStockProducts;
    int healthy = Math.Max(total - low - out_, 0);

    double Pct(int n) => total > 0 ? n * 100.0 / total : 0;
    double healthPct = Pct(healthy);
    int avgStock = total > 0 ? Model.TotalStock / total : 0;
    int maxCat = Model.CategoryStatistics.Any() ? Model.CategoryStatistics.Max(c => c.ProductCount) : 1;
}

<!-- ===== KPI row 1 ===== -->
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <i class="bi bi-box-seam kpi-icon"></i>
            <div class="kpi-label">Total Products</div>
            <div class="kpi-value">@total</div>
            <div class="kpi-hint">Unique items in inventory</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card kpi-warn">
            <i class="bi bi-exclamation-triangle kpi-icon"></i>
            <div class="kpi-label">Low Stock Alerts</div>
            <div class="kpi-value">@low</div>
            <div class="kpi-hint">Items below reorder point</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card kpi-danger">
            <i class="bi bi-x-circle kpi-icon"></i>
            <div class="kpi-label">Out of Stock</div>
            <div class="kpi-value">@out_</div>
            <div class="kpi-hint">Items need immediate reorder</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <i class="bi bi-currency-dollar kpi-icon"></i>
            <div class="kpi-label">Total Value</div>
            <div class="kpi-value">EGP @Model.InventoryValue.ToString("N2")</div>
            <div class="kpi-hint">Current inventory value</div>
        </div>
    </div>
</div>

<!-- ===== KPI row 2 ===== -->
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <i class="bi bi-bar-chart kpi-icon"></i>
            <div class="kpi-label">Avg Stock Level</div>
            <div class="kpi-value">@avgStock</div>
            <div class="kpi-hint">Average units per product</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card kpi-ok">
            <i class="bi bi-graph-up-arrow kpi-icon"></i>
            <div class="kpi-label">Stock Health</div>
            <div class="kpi-value">@healthPct.ToString("0")%</div>
            <div class="kpi-hint">Percentage in stock</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <i class="bi bi-cash-stack kpi-icon"></i>
            <div class="kpi-label">Total Sales</div>
            <div class="kpi-value">EGP @Model.TotalSales.ToString("N0")</div>
            <div class="kpi-hint">All time sales</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <i class="bi bi-cart-plus kpi-icon"></i>
            <div class="kpi-label">Total Purchases</div>
            <div class="kpi-value">EGP @Model.TotalPurchases.ToString("N0")</div>
            <div class="kpi-hint">All time purchases</div>
        </div>
    </div>
</div>

<!-- ===== Category + Status ===== -->
<div class="row g-3 mb-3">
    <div class="col-12 col-lg-6">
        <div class="panel">
            <h2 class="panel-title">Inventory by Category</h2>
            @foreach (var c in Model.CategoryStatistics)
            {
                var w = maxCat > 0 ? c.ProductCount * 100.0 / maxCat : 0;
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1" style="font-size:.75rem;">
                        <span>@c.CategoryName <span class="mini-tag ms-1">@c.ProductCount items</span></span>
                    </div>
                    <div class="thin-progress"><span style="width:@w.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                </div>
            }
            @if (!Model.CategoryStatistics.Any())
            {
                <div class="text-muted small">No categories yet.</div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="panel">
            <h2 class="panel-title">Stock Status Distribution</h2>

            <div class="stack-bar mb-3">
                @if (healthy > 0)
                {
                    <span class="bg-ok" style="width:@Pct(healthy).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">@Pct(healthy).ToString("0")%</span>
                }
                @if (low > 0)
                {
                    <span class="bg-low" style="width:@Pct(low).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                }
                @if (out_ > 0)
                {
                    <span class="bg-out" style="width:@Pct(out_).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                }
            </div>

            <div class="d-flex justify-content-between mb-1" style="font-size:.72rem;"><span><i class="dot bg-ok me-2"></i>In Stock</span><span class="text-muted">@healthy products</span></div>
            <div class="d-flex justify-content-between mb-1" style="font-size:.72rem;"><span><i class="dot bg-low me-2"></i>Low Stock</span><span class="text-muted">@low products</span></div>
            <div class="d-flex justify-content-between mb-3" style="font-size:.72rem;"><span><i class="dot bg-out me-2"></i>Out of Stock</span><span class="text-muted">@out_ products</span></div>

            <hr class="my-3" />
            <div class="row text-center">
                <div class="col-4"><i class="bi bi-check-circle fs-4" style="color:#10b981"></i><div class="fw-bold">@healthy</div><div class="kpi-hint">Healthy Stock</div></div>
                <div class="col-4"><i class="bi bi-exclamation-triangle fs-4" style="color:#d4a006"></i><div class="fw-bold">@low</div><div class="kpi-hint">Need Attention</div></div>
                <div class="col-4"><i class="bi bi-x-circle fs-4" style="color:#ef4444"></i><div class="fw-bold">@out_</div><div class="kpi-hint">Urgent</div></div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Movements + Products ===== -->
<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="panel">
            <h2 class="panel-title"><i class="bi bi-graph-up"></i> Stock Movements (@DateTime.Now.Year)</h2>
            <div style="height:260px"><canvas id="movementsChart"></canvas></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="panel">
            <h2 class="panel-title"><i class="bi bi-clock"></i> Lowest Stock Products</h2>
            @foreach (var p in Model.Products)
            {
                var cls = p.Status == "Available" ? "bg-ok" : p.Status == "Low" ? "bg-low" : "bg-out";
                var txt = p.Status == "Available" ? "OK" : p.Status == "Low" ? "LOW" : "OUT";
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="font-size:.78rem;">
                    <div>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none fw-medium" style="color:#1d63c7">@p.Name</a>
                        <div class="kpi-hint mt-0">Reorder level: @p.ReorderLevel</div>
                    </div>
                    <div class="text-end">
                        <span class="status-pill @cls">@txt</span>
                        <div class="fw-semibold mt-1" style="font-size:.7rem;">@p.Quantity units</div>
                    </div>
                </div>
            }
            @if (!Model.Products.Any())
            {
                <div class="text-muted small">No products available.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(JsonSerializer.Serialize(Model.StockMovements.Select(x => x.Month)));
        const inbound = @Html.Raw(JsonSerializer.Serialize(Model.StockMovements.Select(x => x.Inbound)));
        const outbound = @Html.Raw(JsonSerializer.Serialize(Model.StockMovements.Select(x => x.Outbound)));

        new Chart(document.getElementById("movementsChart"), {
            type: "bar",
            data: {
                labels: labels,
                datasets: [
                    { label: "Inbound", data: inbound, backgroundColor: "#10b981", borderRadius: 4 },
                    { label: "Outbound", data: outbound, backgroundColor: "#1d63c7", borderRadius: 4 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: "bottom", labels: { boxWidth: 10, font: { size: 11 } } } },
                scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: "#f1f3f5" } } }
            }
        });
    </script>
}
